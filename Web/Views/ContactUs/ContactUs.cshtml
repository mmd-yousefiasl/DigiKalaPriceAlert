@using Application.Dtos.ContactUs.ClientSide
@using Domain.Enums.ContactUs
@model ClientSideSendNewContactUsFormDto

@{
    ViewData["Title"] = "تماس با ما | پشتیبانی دیجیتو";
}

@section HeaderReferences {
    <style>
        /* استایل‌های پایه صفحه تماس با ما */
        .contact-wrapper {
            background-color: #f4f4f5;
            padding: 60px 16px;
            direction: rtl;
            font-family: 'Vazir', Tahoma, sans-serif;
            color: #27272a;
            min-height: calc(100vh - 200px);
        }

        .contact-container {
            max-width: 1000px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            border: 1px solid #e4e4e7;
            overflow: hidden;
        }

        /* هدر صفحه تماس */
        .contact-header {
            text-align: center;
            padding: 40px 24px 20px 24px;
        }

        .contact-title {
            font-size: 32px;
            font-weight: 800;
            color: #09090b;
            margin-bottom: 12px;
        }

        .contact-subtitle {
            color: #71717a;
            font-size: 15px;
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* گرید دو ستونه (فرم و اطلاعات) */
        .contact-grid {
            display: grid;
            grid-template-columns: 3fr 2fr;
            gap: 0;
        }

        @@media (max-width: 768px) {
            .contact-grid {
                grid-template-columns: 1fr;
            }
        }

        /* بخش فرم تماس */
        .contact-form-section {
            padding: 40px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: block;
            font-size: 14px;
            font-weight: 700;
            color: #09090b;
            margin-bottom: 8px;
        }

        .form-input,
        .form-select,
        .form-textarea {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #e4e4e7;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14px;
            color: #3f3f46;
            background-color: #fcfcfd;
            transition: all 0.2s ease;
            box-sizing: border-box;
        }

            .form-input:focus,
            .form-select:focus,
            .form-textarea:focus {
                outline: none;
                border-color: #ed1945;
                background-color: #ffffff;
                box-shadow: 0 0 0 3px rgba(237, 25, 69, 0.1);
            }

        .form-textarea {
            resize: vertical;
            min-height: 120px;
        }

        .form-submit-btn {
            width: 100%;
            background-color: #ed1945;
            color: #ffffff;
            border: none;
            padding: 14px 24px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.2s;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

            .form-submit-btn:hover {
                background-color: #d1123a;
                transform: translateY(-2px);
            }

        /* بخش اطلاعات تماس جانبی */
        .contact-info-section {
            background-color: #fafafa;
            padding: 40px;
            border-right: 1px solid #e4e4e7;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        @@media (max-width: 768px) {
            .contact-info-section {
                border-right: none;
                border-top: 1px solid #e4e4e7;
            }
        }

        .info-title {
            font-size: 20px;
            font-weight: 700;
            color: #09090b;
            margin-bottom: 24px;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 24px;
        }

        .info-icon {
            width: 40px;
            height: 40px;
            background-color: #fef2f2;
            color: #ed1945;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .info-details h4 {
            font-size: 15px;
            font-weight: 700;
            color: #09090b;
            margin-bottom: 4px;
        }

        .info-details p,
        .info-details a {
            font-size: 14px;
            color: #71717a;
            text-decoration: none;
            line-height: 1.5;
        }

            .info-details a:hover {
                color: #ed1945;
            }

        .info-telegram-link {
            font-weight: bold;
            color: #ed1945;
            display: inline-block;
            margin-top: 4px;
        }
    </style>
}

<main class="contact-wrapper">
    <div class="contact-container">

        <header class="contact-header">
            <h1 class="contact-title">ارتباط با دیجیتو</h1>
            <p class="contact-subtitle">
                سوالی دارید، نیاز به راهنمایی در ثبت کالا دارید یا پیشنهادی برای توسعه ربات؟ فرم زیر را پر کنید تا کارشناسان ما در سریع‌ترین زمان ممکن پاسخگوی شما باشند.
            </p>
        </header>

        <div class="contact-grid">

            <section class="contact-form-section">
                <form onsubmit="submitAnimation()" asp-area="" asp-controller="ContactUs" asp-action="ContactUs" method="post">

                    <div class="form-group">
                        <label class="form-label" asp-for="FullName">نام و نام خانوادگی</label>
                        <input type="text" asp-for="FullName" class="form-input" placeholder="محم....">
                        <span class="text-danger" asp-validation-for="FullName"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="Mobile">شماره موبایل</label>
                        <input type="text" asp-for="Mobile" class="form-input" placeholder="0912...">
                        <span class="text-danger" asp-validation-for="Mobile"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="Subject">موضوع پیام</label>
                        <select asp-for="Subject" class="form-select" asp-items="Html.GetEnumSelectList<ContactUsFormSubjectEnum>()">
                            <option value="" disabled selected>لطفاً یک موضوع انتخاب کنید...</option>
                        </select>
                        <span class="text-danger" asp-validation-for="Subject"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Message" class="form-label">متن پیام</label>
                        <textarea asp-for="Message" class="form-textarea" placeholder="پیام خود را به صورت کامل اینجا بنویسید..."></textarea>
                        <span class="text-danger" asp-validation-for="Message"></span>
                    </div>

                    <button type="submit" class="form-submit-btn btn-submit">
                        <span>ارسال پیام</span>
                    </button>

                </form>
            </section>

            <aside class="contact-info-section">
                <h3 class="info-title">راه‌های ارتباطی سریع‌تر</h3>

                <div class="info-item">
                    <div class="info-icon">🎫</div>
                    <div class="info-details">
                        <h4>سیستم تیکت پشتیبانی (سریع‌ترین راه)</h4>
                        <p>همه روزه از ساعت ۹ صبح تا ۹ شب</p>
                        <a asp-area="UserPanel" asp-controller="Ticket" asp-action="Index" class="info-telegram-link">ارسال تیکت پشتیبانی در پنل</a>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">📧</div>
                    <div class="info-details">
                        <h4>ایمیل پشتیبانی</h4>
                        <a href="mailto:@SiteTools.SupportEmailAddress">@SiteTools.SupportEmailAddress</a>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">⚡</div>
                    <div class="info-details">
                        <h4>پاسخگویی سریع</h4>
                        <p>کارشناسان ما معمولاً تیکت‌های ارسالی شما را در کمتر از ۱۵ دقیقه بررسی و پاسخ می‌دهند.</p>
                    </div>
                </div>
            </aside>

        </div>
    </div>
</main>