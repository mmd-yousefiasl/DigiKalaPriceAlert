@using Application.Dtos.ContactUs.ClientSide
@using Domain.Enums.ContactUs
@model ClientSideSendNewContactUsFormDto

@{
    ViewData["Title"] = "تماس با ما | پشتیبانی دیجیتو";
}

<div class="contact-wrapper">
    <div class="contact-container">

        <header class="contact-header">
            <h1 class="contact-title">ارتباط با دیجیتو</h1>
            <p class="contact-subtitle">
                سوالی دارید، نیاز به راهنمایی در ثبت کالا دارید یا پیشنهادی برای توسعه ربات؟ فرم زیر را پر کنید تا کارشناسان ما در سریع‌ترین زمان ممکن پاسخگوی شما باشند.
            </p>
        </header>

        <div class="contact-grid">

            <section class="contact-form-section">
                <form onsubmit="submitAnimation()" asp-area="" asp-controller="ContactUs" asp-action="ContactUs" method="post">

                    <div class="form-group">
                        <label class="form-label" asp-for="FullName">نام و نام خانوادگی</label>
                        <input type="text" asp-for="FullName" class="form-input" placeholder="محم....">
                        <span class="text-danger" asp-validation-for="FullName"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="Mobile">شماره موبایل</label>
                        <input type="text" asp-for="Mobile" class="form-input" placeholder="0912...">
                        <span class="text-danger" asp-validation-for="Mobile"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="Subject">موضوع پیام</label>
                        <select asp-for="Subject" class="form-select" asp-items="Html.GetEnumSelectList<ContactUsFormSubjectEnum>()">
                            <option value="" disabled selected>لطفاً یک موضوع انتخاب کنید...</option>
                        </select>
                        <span class="text-danger" asp-validation-for="Subject"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Message" class="form-label">متن پیام</label>
                        <textarea asp-for="Message" class="form-textarea" placeholder="پیام خود را به صورت کامل اینجا بنویسید..."></textarea>
                        <span class="text-danger" asp-validation-for="Message"></span>
                    </div>

                    <button type="submit" class="form-submit-btn btn-submit">
                        <span>ارسال پیام</span>
                    </button>

                </form>
            </section>

            <aside class="contact-info-section">
                <h3 class="info-title">راه‌های ارتباطی سریع‌تر</h3>

                <div class="info-item">
                    <div class="info-icon">🎫</div>
                    <div class="info-details">
                        <h4>سیستم تیکت پشتیبانی (سریع‌ترین راه)</h4>
                        <p>همه روزه از ساعت ۹ صبح تا ۹ شب</p>
                        <a asp-area="UserPanel" asp-controller="Ticket" asp-action="Index" class="info-telegram-link">ارسال تیکت پشتیبانی در پنل</a>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">📧</div>
                    <div class="info-details">
                        <h4>ایمیل پشتیبانی</h4>
                        <a href="mailto:@SiteTools.SupportEmailAddress">@SiteTools.SupportEmailAddress</a>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">⚡</div>
                    <div class="info-details">
                        <h4>پاسخگویی سریع</h4>
                        <p>کارشناسان ما معمولاً تیکت‌های ارسالی شما را در کمتر از ۱۵ دقیقه بررسی و پاسخ می‌دهند.</p>
                    </div>
                </div>
            </aside>

        </div>
    </div>
</div>