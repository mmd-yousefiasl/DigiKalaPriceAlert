@using Domain.Models
@model PagingViewModel

@if (Model.PageCount > 1)
{
    <div class="flex justify-center mb-12">
        @if (Model.StartPage < Model.Page)
        {
            <a href="javascript:void(0);" data-page="@(Model.Page - 1)" onclick="FillPageId(@(Model.Page - 1))" tabindex="-1" class="flex items-center justify-center px-3.5 md:px-4 py-2 mx-1 text-gray-700 transition-colors duration-300 transform bg-white rounded-md -scale-x-100 hover:bg-primary-500 hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 md:size-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
            </a>
        }
        @for (int i = Model.StartPage; i <= Model.EndPage; i++)
        {
            if (Model.Page == i)
            {
                <a href="javascript:void(0);" data-page="0" class="border border-zinc-100 text-sm md:text-base px-3.5 md:px-4 py-2 mx-1 transition-colors duration-300 transform bg-primary-500 text-white rounded-md">
                    @i
                </a>
            }
            else
            {
                <a href="javascript:void(0);" data-page="@i" onclick="FillPageId(@i)" class="border border-zinc-100 text-sm md:text-base px-3.5 md:px-4 py-2 mx-1 text-gray-700 transition-colors duration-300 transform bg-white rounded-md hover:bg-primary-500 hover:text-white">
                    @i
                </a>
            }
        }
        @if (Model.EndPage > Model.Page)
        {
            <a href="javascript:void(0);" data-page="@(Model.Page + 1)" onclick="FillPageId(@(Model.Page + 1))" class="flex items-center justify-center px-3.5 md:px-4 py-2 mx-1 text-gray-700 transition-colors duration-300 transform bg-white rounded-md -scale-x-100 hover:bg-primary-500 hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4 md:size-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
            </a>
        }
    </div>
}