<!DOCTYPE html>
<html lang="fa" dir="rtl" class="scroll-smooth">
<head>
    <partial name="_Meta" />

    <title>دیجیتو | پایش قیمت رقبا و مدیریت بای‌باکس دیجی‌کالا | @ViewData["Title"]</title>
    <script type="importmap"></script>

    <partial name="_HeaderReferences" />

    @await RenderSectionAsync("HeaderReferences", required: false)

    @if (ViewData["CanonicalOverride"] != null)
    {
        <link rel="canonical" href="@ViewData["CanonicalOverride"]" />
    }
    else if (ViewData["NoIndex"] == null || !(bool)ViewData["NoIndex"])
    {
        <link rel="canonical" href="@($"{SiteTools.SiteUrl.TrimEnd('/')}{Context.Request.Path}")" />
    }

    <partial name="_OrganizationSchema" />
</head>
<body class="max-w-[1700px] mx-auto">
    <partial name="_Loader" />

    <div id="progressBar"></div>

    <partial name="_Header" />

    <main class="mt-0 md:mt-8">
        @RenderBody()
    </main>


    <partial name="_Footer" />

    <partial name="_FooterReferences" />
    <partial name="_Notification" />
    <partial name="_ValidationScriptsPartial" />

    @await RenderSectionAsync("FooterReferences", required: false)
</body>
</html>
