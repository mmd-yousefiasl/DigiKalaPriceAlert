<!DOCTYPE html>
<html lang="fa" dir="rtl" class="scroll-smooth">
<head>
    <partial name="_Meta" />

    <title>@ViewData["Title"] | ربات دیجی کالا</title>
    <script type="importmap"></script>

    <partial name="_HeaderReferences" />

    @await RenderSectionAsync("HeaderReferences", required: false)
</head>
<body class="max-w-[1700px] mx-auto">
    <partial name="_Loader" />

    <div id="progressBar"></div>

    <partial name="_Header" />

    <main class="mt-0 md:mt-8">
        @RenderBody()
    </main>


    <partial name="_Footer" />


    <partial name="_FooterReferences" />

    @await RenderSectionAsync("FooterReferences", required: false)
</body>
</html>
