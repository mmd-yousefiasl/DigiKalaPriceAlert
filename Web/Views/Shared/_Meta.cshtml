@{
    // Define the default fallbacks if pages don't specify them
    var metaAuthor = ViewData["MetaAuthor"] as string
        ?? $"تیم استراتژی و فنی {SiteTools.SiteName}";

    var metaDescription = ViewData["MetaDescription"] as string
            ?? "پایش قیمت رقبا و مدیریت هوشمند بای‌باکس دیجی‌کالا. دریافت هشدار تغییر قیمت در کمتر از ۱۵ دقیقه با پیامک برای حفظ سهم ۸۰ درصدی فروش در بازار.";
}

<meta charset="utf-8">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<meta name="robots" content="@(ViewData["NoIndex"] is true ? "noindex, follow" : "index, follow")" />
<meta name="author" content="@metaAuthor">
<meta name="description" content="@metaDescription" />
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">