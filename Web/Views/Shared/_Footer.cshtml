    <!-- links -->
    <div class="flex flex-col md:flex-row gap-y-8">
        <div class="md:w-4/12 flex justify-between">
            <div>
                <div class="text-zinc-500 mb-4 text-sm">
                    منوی اصلی
                </div>
                <div class="">
                    <ul class="flex flex-col gap-y-3">
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="text-zinc-400 hover:text-primary-500 transition-all text-xs hover:pr-1 ease-out duration-300">
                                صفحه اصلی
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="Features" class="text-zinc-400 hover:text-primary-500 transition-all text-xs hover:pr-1 ease-out duration-300">
                                امکانات دیجیتو
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="AboutUs" class="text-zinc-400 hover:text-primary-500 transition-all text-xs hover:pr-1 ease-out duration-300">
                                درباره ما
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div>
                <div class="text-zinc-500 mb-4 text-sm">
                    راهنمای کاربران
                </div>
                <div class="">
                    <ul class="flex flex-col gap-y-3">
                        <li>
                            <a asp-area="" asp-controller="Faq" asp-action="Faq" class="text-zinc-400 hover:text-primary-500 transition-all text-xs hover:pr-1 ease-out duration-300">
                                سوالات متداول
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="TermsAndConditions" class="text-zinc-400 hover:text-primary-500 transition-all text-xs hover:pr-1 ease-out duration-300">
                                قوانین و مقررات
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="PrivacyPolicy" class="text-zinc-400 hover:text-primary-500 transition-all text-xs hover:pr-1 ease-out duration-300">
                                حریم خصوصی
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div>
                <div class="text-zinc-500 mb-4 text-sm">
                    لینک‌های مفید
                </div>
                <div class="">
                    <ul class="flex flex-col gap-y-3">
                        <li>
                            <a asp-area="" asp-controller="Blog" asp-action="BlogsList" asp-route-category="" class="text-zinc-400 hover:text-primary-500 transition-all text-xs hover:pr-1 ease-out duration-300">
                                وبلاگ آموزشی
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="Home" asp-action="Pricing" class="text-zinc-400 hover:text-primary-500 transition-all text-xs hover:pr-1 ease-out duration-300">
                                پلن‌ها و تعرفه‌ها
                            </a>
                        </li>
                        <li>
                            <a asp-area="" asp-controller="ContactUs" asp-action="ContactUs" class="text-zinc-400 hover:text-primary-500 transition-all text-xs hover:pr-1 ease-out duration-300">
                                تماس با ما
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="md:w-4/12 flex justify-center gap-x-7">
            <img class="h-fit max-w-20 md:max-w-28" src="/assets/image/service/symbol-02.png" alt="نماد اعتماد">
            @await Component.InvokeAsync("PaymentDataLogo")
        </div>
        <div class="md:w-4/12">
            <partial name="_SignInNewsLetters" model="@(new ClientSideSignInNewsLettersDto())" />
            @await Component.InvokeAsync("SocialMedia")
        </div>
    </div>
    <!-- copyright -->
    <div class="mt-10 pt-5 text-xs text-zinc-400 border-t border-zinc-200">
        <partial name="_FooterCopyRight" />
    </div>
</footer>