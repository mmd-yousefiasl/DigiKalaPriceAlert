@{
    ViewData["Title"] = "تعرفه و پلن‌های اشتراک پایش قیمت دیجی‌کالا | دیجیتو";
}

@section HeaderReferences {
    <link href="/css/pricing.css" rel="stylesheet" asp-append-version="true" type="text/css" />
}

<div class="digito-wrapper">

    <!-- ============ HEADER ============ -->
    <section class="digito-hero">
        <div class="digito-badge">
            <span class="digito-badge-dot"></span>
            تعرفه‌های شفاف، بدون هزینه‌های پنهان
        </div>
        <h1 class="digito-hero-title">
            خرید اشتراک؛ سرمایه‌گذاری روی <span class="highlight">حفظ بای‌باکس</span>
        </h1>

        @* ==== HERO DESC — NOTIFICATION (active) ==== *@
        <p class="digito-hero-desc">
            با <b>اعلان تغییر قیمت</b> دیجیتو، هر لحظه که رقیبت قیمتش رو عوض کنه، سریع خبردار می‌شی — همیشه یک قدم جلوتر از بازار.
        </p>

        @* ==== HERO DESC — AUTO-PRICING (uncomment to switch) ====
        <p class="digito-hero-desc">
            با <b>قیمت‌گذاری خودکار</b> دیجیتو، قیمت محصولاتت همیشه در محدوده رقابتی می‌مونه — بدون نیاز به دخالت دستی. دستیار هوشمندی که شبانه‌روز مراقب بای‌باکس شماست.
        </p>
        *@

        <!-- Service Toggle -->
        <!-- Service Toggle -->
        <div class="digito-toggle" role="tablist">

            @* ==== TOGGLE — NOTIFICATION (active, first) ==== *@
            <button class="digito-toggle-btn active" data-service="notify" role="tab" aria-selected="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M18 8C18 6.4087 17.3679 4.88258 16.2426 3.75736C15.1174 2.63214 13.5913 2 12 2C10.4087 2 8.88258 2.63214 7.75736 3.75736C6.63214 4.88258 6 6.4087 6 8C6 15 3 17 3 17H21C21 17 18 15 18 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M13.73 21C13.5542 21.3031 13.3019 21.5547 12.9982 21.7295C12.6946 21.9044 12.3504 21.9965 12 21.9965C11.6496 21.9965 11.3054 21.9044 11.0018 21.7295C10.6982 21.5547 10.4458 21.3031 10.27 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                اعلان تغییر قیمت
            </button>

            @* ==== TOGGLE — AUTO-PRICING (VISIBLE, disabled, "به زودی") ==== *@
            <button class="digito-toggle-btn" data-service="auto" data-coming-soon role="tab" aria-selected="false" disabled
                    style="opacity:.55; cursor:not-allowed; pointer-events:none;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                قیمت‌گذاری خودکار
                <span class="digito-toggle-tag">به زودی</span>
            </button>

            @* ==== TOGGLE — AUTO-PRICING (enabled version, for future swap) ====
    <button class="digito-toggle-btn" data-service="auto" role="tab" aria-selected="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        قیمت‌گذاری خودکار
        <span class="digito-toggle-tag">ویژه</span>
    </button>
    *@

        </div>
    </section>

