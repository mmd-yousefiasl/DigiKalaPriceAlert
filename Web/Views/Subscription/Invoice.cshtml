@using Application.Dtos.Orders.ClientSide
@using Application.Tools
@using Domain.Statics
@model ClientSideInvoiceDto

@{
    ViewData["Title"] = "پیش‌نویس فاکتور خرید";

    bool isFree = Model.PlanPrice == 0 ? true : false;
}

@section HeaderReferences {
    <style>
        /* تنظیمات پایه مخصوص صفحه چک‌اوت دیجیتو */
        .digito-checkout-wrapper {
            color: #27272a;
            direction: rtl;
            font-family: 'Vazir';
            padding: 60px 16px;
            box-sizing: border-box;
            line-height: 1.6;
            background-color: #fafafa;
            min-height: 80vh;
            margin: 0px;
        }

            .digito-checkout-wrapper *,
            .digito-checkout-wrapper *::before,
            .digito-checkout-wrapper *::after {
                box-sizing: inherit;
                margin: 0;
                padding: 0;
            }

        .digito-checkout-container {
            max-width: 1000px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 30px;
            align-items: start;
        }

        /* استایل عمومی باکس‌ها */
        .checkout-card {
            background-color: #ffffff;
            border: 1px solid #e4e4e7;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
        }

        .checkout-title {
            color: #18181b;
            font-size: 18px;
            font-weight: 800;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 2px solid #f4f4f5;
            padding-bottom: 12px;
        }

        /* ستون جزئیات فاکتور */
        .plan-summary-box {
            background-color: #fef2f2;
            border: 1px dashed #fca5a5;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 24px;
        }

            /* رنگ‌بندی اختصاصی پلتفرم برای پلن تست */
            .plan-summary-box.free-mode {
                background-color: #f0fdf4;
                border-color: #bbf7d0;
            }

        .plan-summary-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .plan-summary-title {
            color: #09090b;
            font-size: 16px;
            font-weight: bold;
        }

        .plan-summary-badge {
            background-color: #ed1945;
            color: #ffffff;
            font-size: 11px;
            padding: 4px 10px;
            border-radius: 50px;
            font-weight: bold;
        }

            .plan-summary-badge.free-badge {
                background-color: #10b981;
            }

        .plan-summary-desc {
            color: #71717a;
            font-size: 13px;
        }

        /* ردیف‌های قیمت */
        .invoice-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px solid #f4f4f5;
            font-size: 14px;
            color: #52525b;
        }

            .invoice-row.total {
                border-bottom: none;
                padding-top: 20px;
                font-size: 16px;
                font-weight: bold;
                color: #18181b;
            }

                .invoice-row.total .price {
                    color: #ed1945;
                    font-size: 22px;
                    font-weight: 900;
                }

                    .invoice-row.total .price.free-price {
                        color: #10b981;
                    }

        /* بخش ویژگی‌های پلن */
        .checkout-features {
            list-style: none;
            margin-top: 20px;
            background-color: #fafafa;
            padding: 20px;
            border-radius: 12px;
        }

            .checkout-features li {
                font-size: 13px;
                color: #3f3f46;
                margin-bottom: 12px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

        /* دکمه‌های اکشن */
        .btn-checkout-submit {
            display: block;
            width: 100%;
            background-color: #ed1945;
            color: #ffffff;
            border: none;
            padding: 16px 20px;
            border-radius: 12px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(237, 25, 69, 0.2);
            text-align: center;
            text-decoration: none;
        }

            .btn-checkout-submit:hover {
                background-color: #d1123a;
            }

            .btn-checkout-submit.btn-free {
                background-color: #10b981;
                box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
            }

                .btn-checkout-submit.btn-free:hover {
                    background-color: #059669;
                }

        /* استایل مینی‌مال تک‌درگاه زی‌بال */
        .zibal-notice-box {
            border: 1px solid #e4e4e7;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 14px;
            background-color: #fff;
        }

        .zibal-logo-mock {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: white;
            font-size: 20px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            box-shadow: 0 2px 4px rgba(37, 99, 113, 0.1);
        }

        .zibal-text h4 {
            font-size: 14px;
            font-weight: bold;
            color: #18181b;
            margin-bottom: 2px;
        }

        .zibal-text p {
            font-size: 12px;
            color: #71717a;
        }

        @@media (max-width: 768px) {
            .digito-checkout-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<main class="digito-checkout-wrapper">
    <div class="digito-checkout-container">

        <div class="checkout-card">
            <h2 class="checkout-title">🧾 صورت‌حساب و تایید نهایی</h2>

            @if (isFree)
            {
                <div class="plan-summary-box free-mode">
                    <div class="plan-summary-header">
                        <span class="plan-summary-title">@Model.PlanTitle</span>
                        <span class="plan-summary-badge free-badge">رایگان / هدیه عضویت</span>
                    </div>
                    <p class="plan-summary-desc">@Model.ShortDescription</p>
                </div>

                <div class="invoice-details">
                    <div class="invoice-row">
                        <span>مدت اعتبار تست:</span>
                        <strong>
                            @Model.DurationInDays
                            روز کامل
                        </strong>
                    </div>
                    <div class="invoice-row">
                        <span>تعداد کالای قابل پایش:</span>
                        <strong>
                            تا
                            @SiteTools.MaximumProductCount
                            کالا
                            (بررسی هر ۱۵ دقیقه)
                        </strong>
                    </div>
                    <div class="invoice-row total">
                        <span>مبلغ قابل پرداخت:</span>
                        <span class="price free-price">رایگان</span>
                    </div>
                </div>
            }
            else
            {
                <div class="plan-summary-box">
                    <div class="plan-summary-header">
                        <span class="plan-summary-title">@Model.PlanTitle</span>
                        @if (Model.IsPopular)
                        {
                            <span class="plan-summary-badge">محبوب‌ترین انتخاب</span>
                        }
                    </div>
                    <p class="plan-summary-desc">@Model.ShortDescription</p>
                </div>

                <div class="invoice-details">
                    <div class="invoice-row">
                        <span>مدت اعتبار اشتراک:</span>
                        <strong>
                            @Model.DurationInDays
                            روز کامل
                        </strong>
                    </div>
                    <div class="invoice-row">
                        <span>تعداد کالای قابل پایش همزمان:</span>
                        <strong>
                            تا
                            @SiteTools.MaximumProductCount
                            کالا
                            (هر ۱۵ دقیقه)
                        </strong>
                    </div>
                    <div class="invoice-row">
                        <span>هزینه پایه اشتراک:</span>
                        <span>@Model.PlanPrice?.ToToman()</span>
                    </div>
                    <div class="invoice-row total">
                        <span>مبلغ قابل پرداخت:</span>
                        <span class="price">
                            @Model.PlanPrice?.ToTomanFormat()
                            <span style="font-size: 13px; font-weight: normal; color: #71717a;">تومان</span>
                        </span>
                    </div>
                </div>
            }

            <ul class="checkout-features">
                @foreach (var item in Model.Features ?? new List<string>())
                {
                    <li><span style="color: #10b981;">✔️</span>@item</li>
                }
            </ul>
        </div>

        <div>
            <div class="checkout-card">

                @if (isFree)
                {
                    <h3 class="checkout-title" style="font-size: 16px; margin-bottom: 20px; border-color: #e4e4e7;">🚀 فعال‌سازی حساب کاربری</h3>

                    <p style="font-size: 13px; color: #52525b; margin-bottom: 24px; text-align: justify;">
                        برای شروع استفاده از سیستم پایش قیمت دیجیتو نیازی به پرداخت وجه نیست. با کلیک روی دکمه زیر، اشتراک تست ۷ روزه فوراً روی حساب شما اعمال شده و به صفحه مدیریت کالاها منتقل می‌شوید.
                    </p>

                    <form asp-area="" asp-controller="Subscription" asp-action="Checkout" method="post">
                        <button type="submit" class="btn-checkout-submit btn-free">
                            فعال‌سازی رایگان اشتراک تست 🎉
                        </button>
                    </form>
                }
                else
                {
                    <h3 class="checkout-title" style="font-size: 16px; margin-bottom: 20px;">🔒 پرداخت و نهایی‌سازی سفارش</h3>

                    <div style="display: flex; justify-content: space-between; align-items: center; background-color: #f4f4f5; padding: 12px 16px; border-radius: 12px; margin-bottom: 16px; font-size: 13px;">
                        <span style="color: #52525b;">موجودی فعلی کیف پول شما:</span>
                        <strong style="color: #18181b;">@Model.UserBalance.ToTomanFormat() تومان</strong>
                    </div>

                    <form asp-area="" asp-controller="Subscription" asp-action="Checkout" method="post" onsubmit="submitAnimation()">
                        @if (Model.UserBalance > 0)
                        {
                            <div style="border: 1px solid #e4e4e7; border-radius: 12px; padding: 16px; margin-bottom: 20px; background-color: #fff; display: flex; align-items: flex-start; gap: 12px;">
                                <input type="checkbox" id="useBalance" name="UseBalance" value="true" style="margin-top: 4px; width: 16px; height: 16px; accent-color: #ed1945; cursor: pointer;" />
                                <label for="useBalance" style="cursor: pointer; user-select: none;">
                                    <strong style="font-size: 14px; color: #18181b; display: block; margin-bottom: 2px;">کسر از موجودی کیف پول</strong>
                                    <span style="font-size: 12px; color: #71717a; display: block; text-align: justify;">
                                        تمایل دارم مبلغ سفارش از موجودی حسابم کسر شود. (در صورت عدم تکافوی موجودی، مابه‌التفاوت از درگاه بانکی کسر خواهد شد).
                                    </span>
                                </label>
                            </div>
                        }

                        <div class="zibal-notice-box">
                            <div class="zibal-logo-mock">Z</div>
                            <div class="zibal-text">
                                <h4>پرداخت آنلاین از طریق درگاه زی‌بال</h4>
                                <p>اتصال مستقیم به کلیه کارت‌های عضو شتاب (در صورت نیاز به پرداخت آنلاین)</p>
                            </div>
                        </div>

                        <button type="submit" class="btn-checkout-submit btn-submit">
                            تایید نهایی و پردازش فاکتور 🚀
                        </button>
                    </form>

                    <p style="color: #71717a; font-size: 11px; text-align: center; margin-top: 16px;">
                        پس از تایید، سیستم موجودی شما را بررسی کرده و در صورت نیاز شما را به درگاه متصل می‌کند.
                    </p>
                }

            </div>

            <div style="text-align: center; margin-top: 20px;">
                <a asp-area="" asp-controller="Subscription" asp-action="Pricing" style="color: #71717a; font-size: 13px; text-decoration: none;">
                    ← انصراف و بازگشت به جدول پلن‌ها
                </a>
            </div>
        </div>

    </div>
</main>