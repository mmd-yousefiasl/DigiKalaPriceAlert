@model int
@{
    ViewData["Title"] = "پرداخت موفقیت‌آمیز";
}

@section HeaderReferences {
    <style>
        .digito-payment-wrapper {
            color: #27272a;
            direction: rtl;
            font-family: 'Vazir';
            padding: 80px 16px;
            box-sizing: border-box;
            line-height: 1.6;
            background-color: #fafafa;
            min-height: 85vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .digito-payment-wrapper *,
            .digito-payment-wrapper *::before,
            .digito-payment-wrapper *::after {
                box-sizing: inherit;
                margin: 0;
                padding: 0;
            }

        .payment-status-card {
            background-color: #ffffff;
            border: 1px solid #e4e4e7;
            border-radius: 20px;
            padding: 45px 30px;
            max-width: 500px;
            width: 100%;
            text-align: center;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.03);
        }

        .status-icon-box {
            width: 80px;
            height: 80px;
            background-color: #f0fdf4;
            color: #10b981;
            font-size: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            margin: 0 auto 20px auto;
            border: 2px solid #bbf7d0;
        }

        .payment-status-card h2 {
            color: #10b981;
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .payment-status-card p {
            color: #71717a;
            font-size: 14px;
            margin-bottom: 24px;
        }

        .payment-details-list {
            background-color: #f8fafc;
            border: 1px dashed #cbd5e1;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 32px;
            list-style: none;
            text-align: right;
        }

            .payment-details-list li {
                display: flex;
                justify-content: space-between;
                font-size: 13px;
                color: #475569;
                padding: 8px 0;
            }

                .payment-details-list li:not(:last-child) {
                    border-bottom: 1px solid #e2e8f0;
                }

        .btn-payment-action {
            display: inline-block;
            width: 100%;
            background-color: #10b981;
            color: #ffffff;
            padding: 14px 24px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: bold;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
        }

            .btn-payment-action:hover {
                background-color: #059669;
                box-shadow: 0 6px 16px rgba(16, 185, 129, 0.3);
            }
    </style>
}

<main class="digito-payment-wrapper">
    <div class="payment-status-card">
        <div class="status-icon-box">✓</div>

        <h2>پرداخت با موفقیت انجام شد!</h2>
        <p>اشتراک شما فعال گردید. هم‌اکنون سیستم پایش قیمت فعال است.</p>

        <ul class="payment-details-list">
            <li>
                <span>شماره فاکتور سیستم:</span>
                <strong>#@Model</strong>
            </li>
            <li>
                <span>وضعیت تراکنش:</span>
                <span style="color: #10b981; font-weight: bold;">تایید شده (کیف پول)</span>
            </li>
            <li>
                <span>زمان اعمال تمدید:</span>
                <strong>هم‌اکنون</strong>
            </li>
        </ul>

        <a asp-area="UserPanel" asp-controller="Home" asp-action="Index" class="btn-payment-action">
            🚀 ورود به میز کار و مدیریت کالاها
        </a>
    </div>
</main>