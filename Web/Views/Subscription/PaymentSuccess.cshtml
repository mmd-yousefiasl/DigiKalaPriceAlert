@model string
@{
    ViewData["Title"] = "پرداخت موفقیت‌آمیز";
}

<div class="digito-payment-wrapper">
    <div class="payment-status-card">
        <div class="status-icon-box">✓</div>

        <h2>پرداخت با موفقیت انجام شد!</h2>
        <p>اشتراک شما فعال گردید. هم‌اکنون سیستم پایش قیمت فعال است.</p>

        <ul class="payment-details-list">
            <li>
                <span>شماره فاکتور سیستم:</span>
                <strong>@Model</strong>
            </li>
            <li>
                <span>وضعیت تراکنش:</span>
                <span style="color: #10b981; font-weight: bold;">تایید شده (کیف پول)</span>
            </li>
            <li>
                <span>زمان اعمال تمدید:</span>
                <strong>هم‌اکنون</strong>
            </li>
        </ul>

        <a asp-area="UserPanel" asp-controller="Home" asp-action="Index" class="btn-payment-action">
            🚀 ورود به میز کار و مدیریت کالاها
        </a>
    </div>
</div>