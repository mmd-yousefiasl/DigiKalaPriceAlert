@{
    ViewData["Title"] = "امکانات سامانه پایش قیمت و بای‌باکس دیجی‌کالا | دیجیتو";
}

@section HeaderReferences {
    <link rel="stylesheet" href="/css/features.css" type="text/css" asp-append-version="true" />
}

<div class="digito-main">
    <section class="digito-hero">
        <div class="digito-badge">
            <span class="digito-badge-dot"></span>
            سیستم هوشمند پایش قیمت فروشندگان دیجی‌کالا
        </div>
        <h1 class="digito-hero-title">
            سامانه مانیتورینگ قیمت و تضمین تصاحب <span class="highlight">بای‌باکس دیجی‌کالا</span>
        </h1>
        <p class="digito-hero-desc">
            به عنوان یک فروشنده دیجی‌کالا، با دیجیتو نوسان قیمت رقبا را در لحظه رصد کنید، جایگاه بای‌باکس (Buy Box) را مقتدرانه حفظ کنید و با دریافت هشدارهای سریع پیامکی، افزایش فروش و سودآوری خود را بدون نیاز به بررسی مداوم سایت تضمین کنید.
        </p>
        <div class="digito-btn-container">
            <a asp-area="" asp-controller="Subscription" asp-action="Purchase" asp-route-planId="1" class="digito-btn-primary">
                <span class="btn-icon-wrapper">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C15 4 17 8 16.5 13C16.3 14.8 15.6 16.5 14.5 18L12 20.5L9.5 18C8.4 16.5 7.7 14.8 7.5 13C7 8 9 4 12 2Z" stroke="white" stroke-width="1.8" stroke-linejoin="round" />
                        <circle cx="12" cy="10" r="2" stroke="white" stroke-width="1.8" />
                        <path d="M8 16L5.5 17.5C5 17.8 4.7 18.3 4.7 18.9V20.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M16 16L18.5 17.5C19 17.8 19.3 18.3 19.3 18.9V20.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    شروع تست ۷ روزه (همین حالا)
                </span>
            </a>
            <a href="#how-it-works" class="digito-btn-secondary">
                چرا به سیستم دیجیتو نیاز داریم؟
            </a>
        </div>
    </section>

    <section class="digito-features">
        <div class="digito-section-header">
            <h2 class="digito-section-title">امکانات پنل پایش قیمت دیجیتو برای افزایش فروش دیجی‌کالا</h2>
            <p class="digito-section-subtitle">با نرم‌افزار مانیتورینگ قیمت ما، همیشه یک قدم از رقبای خود جلوتر باشید و بای‌باکس را از دست ندهید.</p>
        </div>

        <div class="digito-grid">
            <div class="digito-card">
                <div class="digito-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2 12C2 12 5.5 5 12 5C18.5 5 22 12 22 12C22 12 18.5 19 12 19C5.5 19 2 12 2 12Z" stroke="#a1a1aa" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="12" cy="12" r="3.2" stroke="#ed1945" stroke-width="1.8" />
                    </svg>
                </div>
                <h3 class="digito-card-title">پایش ۲4 ساعته و فتح بای‌باکس</h3>
                <p class="digito-card-desc">الگوریتم‌های هوشمند ما به صورت شبانه‌روزی وضعیت جعبه خرید (Buy-Box) کالاها را رصد می‌کنند. نتیجه؟ به محض تغییر جایگاه، سریعاً مطلع شده و با اصلاح قیمت، دوباره فروش را به دست می‌آورید.</p>
            </div>

            <div class="digito-card">
                <div class="digito-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M18 9V11.764C18 12.9092 18.3385 14.0286 18.9727 14.9812L19.7071 16.0828C20.4207 17.1543 19.6541 18.5833 18.3675 18.5833H5.63252C4.34588 18.5833 3.57932 17.1543 4.29289 16.0828L5.02733 14.9812C5.66148 14.0286 6 12.9092 6 11.764V9C6 5.68629 8.68629 3 12 3C15.3137 3 18 5.68629 18 9Z" stroke="#a1a1aa" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M9.5 20.5C10 21.5 10.9 22 12 22C13.1 22 14 21.5 14.5 20.5" stroke="#ed1945" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                </div>
                <h3 class="digito-card-title">ارسال فوری پیامک (SMS) هشدار</h3>
                <p class="digito-card-desc">دیگر نیازی به چک کردن دستی پنل فروشندگان (سلر سنتر) نیست. هرگونه کاهش یا افزایش قیمت توسط رقیب، در کوتاه‌ترین زمان به صورت پیامک همراه با لینک مستقیم کالا برای شما ارسال می‌شود.</p>
            </div>

            <div class="digito-card">
                <div class="digito-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 20.5H21" stroke="#a1a1aa" stroke-width="1.8" stroke-linecap="round" />
                        <path d="M6 20.5V14" stroke="#a1a1aa" stroke-width="1.8" stroke-linecap="round" />
                        <path d="M12 20.5V9" stroke="#ed1945" stroke-width="1.8" stroke-linecap="round" />
                        <path d="M18 20.5V5" stroke="#ed1945" stroke-width="1.8" stroke-linecap="round" />
                        <path d="M5 11L10 6L14 9L20 3" stroke="#ed1945" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <h3 class="digito-card-title">تحلیل روند و گزارش روزانه نوسانات</h3>
                <p class="digito-card-desc">با دسترسی به گزارش متنی روزانه از وضعیت نوسانات بازار، رفتار رقبای خود را آنالیز کنید. این ویژگی به شما کمک می‌کند تا هوشمندانه‌ترین استراتژی را برای رقابت و داشتن حاشیه سود بالاتر پیاده کنید.</p>
            </div>

            <div class="digito-card">
                <div class="digito-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="5" y="4" width="14" height="17" rx="2" stroke="#a1a1aa" stroke-width="1.8" />
                        <path d="M9 4C9 2.89543 9.89543 2 11 2H13C14.1046 2 15 2.89543 15 4V4.5C15 5.05228 14.5523 5.5 14 5.5H10C9.44772 5.5 9 5.05228 9 4.5V4Z" stroke="#a1a1aa" stroke-width="1.8" />
                        <path d="M9 12H15" stroke="#ed1945" stroke-width="1.8" stroke-linecap="round" />
                        <path d="M9 16H13" stroke="#ed1945" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                </div>
                <h3 class="digito-card-title">مدیریت متمرکز در پنل تحت وب</h3>
                <p class="digito-card-desc">در داشبورد اختصاصی سایت، لیست تمام کالاهای تحت نظر را به صورت یکپارچه مدیریت کنید. افزودن، حذف یا توقف پایش محصولات تنها با چند کلیک ساده و بدون پیچیدگی امکان‌پذیر است.</p>
            </div>

            <div class="digito-card">
                <div class="digito-icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L20 5.5V11C20 16.25 16.5 20.5 12 22C7.5 20.5 4 16.25 4 11V5.5L12 2Z" stroke="#a1a1aa" stroke-width="1.8" stroke-linejoin="round" />
                        <path d="M9 12L11 14L15.5 9.5" stroke="#ed1945" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <h3 class="digito-card-title">۱۰۰٪ امن (بدون نیاز به پسورد پنل)</h3>
                <p class="digito-card-desc">امنیت اطلاعات شما خط قرمز ماست! دیجیتو دیتای خود را مستقیماً از صفحات عمومی وب‌سایت دیجی‌کالا استخراج می‌کند، در نتیجه نیازی به رمز عبور پنل مرچنت (Seller) یا دسترسی‌های حساس شما نداریم.</p>
            </div>
        </div>
    </section>

    <section id="how-it-works" class="digito-how-it-works">
        <div class="digito-section-header">
            <h2 class="digito-section-title">شروع نظارت بر رقبا در ۴ گام ساده</h2>
            <p class="digito-section-subtitle">فرآیند اتصال به سیستم مانیتورینگ قیمت دیجیتو بسیار سریع و بدون پیچیدگی است.</p>
        </div>

        <div class="digito-step-grid">
            <div class="digito-step-item">
                <div class="digito-step-number">۱</div>
                <h4 class="digito-step-title">عضویت سریع در سایت</h4>
                <p class="digito-step-desc">با شماره موبایل خود در سایت ثبت‌نام کنید و حساب کاربری خود را در کمتر از ۱۰ ثانیه ایجاد کنید.</p>
            </div>
            <div class="digito-step-item">
                <div class="digito-step-number">۲</div>
                <h4 class="digito-step-title">ثبت لینک یا DKP کالا</h4>
                <p class="digito-step-desc">لینک صفحات دیجی‌کالا یا شناسه کالا (DKP) محصولاتی که قصد پایش آن‌ها را دارید در پنل خود وارد کنید.</p>
            </div>
            <div class="digito-step-item">
                <div class="digito-step-number">۳</div>
                <h4 class="digito-step-title">دریافت پیامک‌های آنی</h4>
                <p class="digito-step-desc">پایش منظم آغاز می‌شود؛ با هر تغییر قیمت رقیب، پیامکی حاوی لینک مستقیم ورود به صفحه محصول دریافت می‌کنید.</p>
            </div>
            <div class="digito-step-item">
                <div class="digito-step-number active">۴</div>
                <h4 class="digito-step-title">اصلاح قیمت و رشد فروش</h4>
                <p class="digito-step-desc">نتیجه نهایی: روی لینک پیامک کلیک می‌کنید، قیمت را در سریع‌ترین زمان اصلاح کرده و بای‌باکس را مال خود می‌کنید.</p>
            </div>
        </div>
    </section>

    <section class="digito-stats">
        <div>
            <div class="digito-stat-number">۱۵ دقیقه</div>
            <div class="digito-stat-label">فاصله زمانی هر بررسی قیمت</div>
        </div>
        <div class="digito-border-x">
            <div class="digito-stat-number">۲۴/۷</div>
            <div class="digito-stat-label">پایش بدون وقفه، حتی نیمه‌شب</div>
        </div>
        <div>
            <div class="digito-stat-number">۷ روز</div>
            <div class="digito-stat-label">تست کاملاً رایگان، بدون نیاز به کارت بانکی</div>
        </div>
    </section>
</div>