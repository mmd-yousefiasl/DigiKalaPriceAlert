@{
    ViewData["Title"] = "تماس باما";
}

@section HeaderReferences {
    <style>
        /* استایل‌های پایه صفحه تماس با ما */
        .contact-wrapper {
            background-color: #f4f4f5;
            padding: 60px 16px;
            direction: rtl;
            font-family: 'Vazir', Tahoma, sans-serif;
            color: #27272a;
            min-height: calc(100vh - 200px);
        }

        .contact-container {
            max-width: 1000px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 20px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            border: 1px solid #e4e4e7;
            overflow: hidden;
        }

        /* هدر صفحه تماس */
        .contact-header {
            text-align: center;
            padding: 40px 24px 20px 24px;
        }

        .contact-title {
            font-size: 32px;
            font-weight: 800;
            color: #09090b;
            margin-bottom: 12px;
        }

        .contact-subtitle {
            color: #71717a;
            font-size: 15px;
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* گرید دو ستونه (فرم و اطلاعات) */
        .contact-grid {
            display: grid;
            grid-template-columns: 3fr 2fr;
            gap: 0;
        }

        @@media (max-width: 768px) {
            .contact-grid {
                grid-template-columns: 1fr;
            }
        }

        /* بخش فرم تماس */
        .contact-form-section {
            padding: 40px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: block;
            font-size: 14px;
            font-weight: 700;
            color: #09090b;
            margin-bottom: 8px;
        }

        .form-input,
        .form-select,
        .form-textarea {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #e4e4e7;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14px;
            color: #3f3f46;
            background-color: #fcfcfd;
            transition: all 0.2s ease;
            box-sizing: border-box;
        }

            .form-input:focus,
            .form-select:focus,
            .form-textarea:focus {
                outline: none;
                border-color: #ed1945;
                background-color: #ffffff;
                box-shadow: 0 0 0 3px rgba(237, 25, 69, 0.1);
            }

        .form-textarea {
            resize: vertical;
            min-height: 120px;
        }

        .form-submit-btn {
            width: 100%;
            background-color: #ed1945;
            color: #ffffff;
            border: none;
            padding: 14px 24px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.2s;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

            .form-submit-btn:hover {
                background-color: #d1123a;
                transform: translateY(-2px);
            }

        /* بخش اطلاعات تماس جانبی */
        .contact-info-section {
            background-color: #fafafa;
            padding: 40px;
            border-right: 1px solid #e4e4e7;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        @@media (max-width: 768px) {
            .contact-info-section {
                border-right: none;
                border-top: 1px solid #e4e4e7;
            }
        }

        .info-title {
            font-size: 20px;
            font-weight: 700;
            color: #09090b;
            margin-bottom: 24px;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            margin-bottom: 24px;
        }

        .info-icon {
            width: 40px;
            height: 40px;
            background-color: #fef2f2;
            color: #ed1945;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .info-details h4 {
            font-size: 15px;
            font-weight: 700;
            color: #09090b;
            margin-bottom: 4px;
        }

        .info-details p,
        .info-details a {
            font-size: 14px;
            color: #71717a;
            text-decoration: none;
            line-height: 1.5;
        }

            .info-details a:hover {
                color: #ed1945;
            }

        .info-telegram-link {
            font-weight: bold;
            color: #ed1945;
            display: inline-block;
            margin-top: 4px;
        }
    </style>
}

<main class="contact-wrapper">
    <div class="contact-container">
        
        <header class="contact-header">
            <h1 class="contact-title">ارتباط با دیجیتو</h1>
            <p class="contact-subtitle">
                سوالی دارید، نیاز به راهنمایی در ثبت کالا دارید یا پیشنهادی برای توسعه ربات؟ فرم زیر را پر کنید تا کارشناسان ما در سریع‌ترین زمان ممکن پاسخگوی شما باشند.
            </p>
        </header>

        <div class="contact-grid">
            
            <section class="contact-form-section">
                <form action="#" method="POST">
                    
                    <div class="form-group">
                        <label for="fullName" class="form-label">نام و نام خانوادگی / نام فروشگاه</label>
                        <input type="text" id="fullName" name="fullName" class="form-input" placeholder="مثال: فروشگاه عصر دیجیتال" required>
                    </div>

                    <div class="form-group">
                        <label for="contactWay" class="form-label">شماره موبایل یا آیدی تلگرام</label>
                        <input type="text" id="contactWay" name="contactWay" class="form-input" placeholder="0912... یا ID@@" required>
                    </div>

                    <div class="form-group">
                        <label for="subject" class="form-label">موضوع پیام</label>
                        <select id="subject" name="subject" class="form-select" required>
                            <option value="" disabled selected>لطفاً یک موضوع انتخاب کنید...</option>
                            <option value="support">پشتیبانی و راهنمایی کار با ربات</option>
                            <option value="billing">سوالات مربوط به تعرفه‌ها و اشتراک</option>
                            <option value="bug">گزارش مشکل فنی در دریافت اعلان‌ها</option>
                            <option value="other">سایر موارد و پیشنهادات</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="message" class="form-label">متن پیام</label>
                        <textarea id="message" name="message" class="form-textarea" placeholder="پیام خود را به صورت کامل اینجا بنویسید..." required></textarea>
                    </div>

                    <button type="submit" class="form-submit-btn">
                        <span>ارسال پیام</span>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                    </button>
                    
                </form>
            </section>

            <aside class="contact-info-section">
                <h3 class="info-title">راه‌های ارتباطی سریع‌تر</h3>
                
                <div class="info-item">
                    <div class="info-icon">🎧</div>
                    <div class="info-details">
                        <h4>پشتیبانی تلگرامی (سریع‌ترین راه)</h4>
                        <p>همه روزه از ساعت ۹ صبح تا ۹ شب</p>
                        <a href="https://t.me/DigitoSupport" target="_blank" class="info-telegram-link">@@DigitoSupport</a>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">📧</div>
                    <div class="info-details">
                        <h4>ایمیل پشتیبانی</h4>
                        <a href="mailto:support@digito.com">support@digito.com</a>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">⚡</div>
                    <div class="info-details">
                        <h4>پاسخگویی سریع</h4>
                        <p>تیم پشتیبانی ما معمولاً پیام‌های تلگرامی را در کمتر از ۱۵ دقیقه پاسخ می‌دهد.</p>
                    </div>
                </div>
            </aside>

        </div>
    </div>
</main>