@{
    ViewData["Title"] = "پایش قیمت رقبا و مدیریت بای‌باکس دیجی‌کالا | دیجیتو";
}

<div class="seller-main-container" dir="rtl">
    <section class="section-wrapper hero-section">
        <div class="container">
            <div class="row-layout">
                <div class="col-6 hero-content">
                    <h1>ربات هوشمند پایش قیمت رقبا در <span>دیجی‌کالا</span>؛ ابزار برنده شدن در بای‌باکس!</h1>

                    <p>
                        به عنوان فروشنده مارکت‌پلیس، نوسان مانیتورینگ قیمت دیجی‌کالا مستقیماً روی نرخ برنده شدن در بای‌باکس (Buy Box) و حجم فروش فروشگاه شما تأثیر می‌گذارد. با سرویس دیجیتو (دیجی‌پرایس‌الرت)، کافیست لینک کالا را در پنل خود ثبت کنید تا سیستم خودکار به عنوان یک ربات اعلام تغییر قیمت دیجی‌کالا، رقبا را رصد کند. به محض کوچک‌ترین کاهش یا افزایش قیمت، فوراً گزارش کامل بازار همراه با لینک مستقیم کالا از طریق ربات تلگرام برای شما ارسال می‌شود تا سهم بازار و سود فروشندگی خود را حفظ کنید.
                    </p>

                    <div>
                        <a class="btn btn-red" title="تعرفه‌های اشتراک ربات پایش قیمت دیجی کالا" asp-area="" asp-controller="Subscription" asp-action="Pricing">
                            <span style="display:inline-flex; align-items:center; gap:6px;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 3C9 3 8 5 8 6.5C8 7.5 8.5 8 9 8.3" stroke="white" stroke-width="1.8" stroke-linecap="round" />
                                    <path d="M6 8.5C4 10 3 12.5 3 15C3 18.5 6.5 21 12 21C17.5 21 21 18.5 21 15C21 12.5 20 10 18 8.5C16.5 7.5 14.5 7 12 7C9.5 7 7.5 7.5 6 8.5Z" stroke="white" stroke-width="1.8" stroke-linejoin="round" />
                                    <path d="M12 12V17M10 13.5H13C13.5 13.5 14 13.9 14 14.5C14 15.1 13.5 15.5 13 15.5H11C10.5 15.5 10 15.9 10 16.5C10 17.1 10.5 17.5 11 17.5H14" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                مشاهده قیمت و تعرفه‌ها
                            </span>
                        </a>
                        <a class="btn btn-outline" title="ثبت نام و تست رایگان سیستم مانیتورینگ قیمت" asp-area="" asp-controller="Subscription" asp-action="Purchase" asp-route-planId="1">
                            <span style="display:inline-flex; align-items:center; gap:6px;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 2C15 4 17 8 16.5 13C16.3 14.8 15.6 16.5 14.5 18L12 20.5L9.5 18C8.4 16.5 7.7 14.8 7.5 13C7 8 9 4 12 2Z" stroke="#ed1945" stroke-width="1.8" stroke-linejoin="round" />
                                    <circle cx="12" cy="10" r="2" stroke="#ed1945" stroke-width="1.8" />
                                    <path d="M8 16L5.5 17.5C5 17.8 4.7 18.3 4.7 18.9V20.5" stroke="#ed1945" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M16 16L18.5 17.5C19 17.8 19.3 18.3 19.3 18.9V20.5" stroke="#ed1945" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                شروع تست رایگان ۷ روزه
                            </span>
                        </a>
                    </div>
                </div>

                <div class="col-6">
                    <div class="mockup-display" role="img" aria-label="شبیه‌ساز پیام ربات تلگرام هشدار تغییر قیمت بای باکس دیجی کالا">
                        <div class="mockup-top">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="7" y="2" width="10" height="20" rx="2" stroke="#ed1945" stroke-width="1.8" />
                                <path d="M11 19H13" stroke="#ed1945" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                            ربات تلگرام دیجیتو
                        </div>
                        <div class="mockup-msg">محصول جدید با موفقیت ثبت شد. پایش منظم و بررسی خودکار وضعیت بای‌باکس آغاز گردید...</div>
                        <div class="mockup-msg mockup-alert">
                            <span>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M4 6C4 4.9 4.9 4 6 4H18C19.1 4 20 4.9 20 6V14C20 15.1 19.1 16 18 16H9L5 19.5V16H6C4.9 16 4 15.1 4 14V6Z" stroke="#a1a1aa" stroke-width="1.8" stroke-linejoin="round" />
                                </svg>
                                [ربات هشدار قیمت دیجیتو]
                            </span><br>
                            <strong>هشدار تغییر قیمت رقبا در دیجی‌کالا</strong><br><br>
                            <span>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M9 15L15 9" stroke="#ed1945" stroke-width="1.8" stroke-linecap="round" />
                                    <path d="M11 6L12.5 4.5C13.8 3.2 15.9 3.2 17.2 4.5C18.5 5.8 18.5 7.9 17.2 9.2L15.7 10.7" stroke="#a1a1aa" stroke-width="1.8" stroke-linecap="round" />
                                    <path d="M13 18L11.5 19.5C10.2 20.8 8.1 20.8 6.8 19.5C5.5 18.2 5.5 16.1 6.8 14.8L8.3 13.3" stroke="#a1a1aa" stroke-width="1.8" stroke-linecap="round" />
                                </svg>
                                ورود به پنل و اصلاح سریع قیمت کالا:
                            </span><br>
                            <code>digipricealert.ir/user/products/list</code>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="steps" class="section-wrapper">
        <div class="container">
            <div class="center-title">
                <h2>نظارت بر قیمت کالاها در ۳ مرحله ساده</h2>
                <p>فرآیندی شفاف، خودکار و بدون پیچیدگی برای رصد مداوم قیمت‌های رقبا</p>
            </div>
            <div class="grid-3-columns">
                <div class="grid-cell">
                    <span class="icon-container">
                        <svg viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" /></svg>
                    </span>
                    <h3>۱. ثبت لینک محصول</h3>
                    <p>لینک صفحه محصول موردنظرتان را از وب‌سایت یا اپلیکیشن دیجی‌کالا کپی کرده و آن را به سادگی در پنل اختصاصی سایت وارد کنید.</p>
                </div>
                <div class="grid-cell">
                    <span class="icon-container">
                        <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" /></svg>
                    </span>
                    <h3>۲. پایش خودکار و مداوم</h3>
                    <p>سیستم هوشمند ما بدون توقف، در بازه‌های زمانی منظم و دوره‌ای قیمت روز کالا و وضعیت بای‌باکس را استخراج و مقایسه می‌کند.</p>
                </div>
                <div class="grid-cell">
                    <span class="icon-container">
                        <svg viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" /></svg>
                    </span>
                    <h3>۳. دریافت فوری هشدار در تلگرام</h3>
                    <p>نیازی به چک کردن مداوم ندارید؛ به محض اینکه قیمت رقیب تغییر کند، ربات تلگرام ما گزارش کامل بازار را همراه با لینک مستقیم ورود به صفحه محصول برای شما ارسال می‌کند.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="plans" class="section-wrapper bg-alt-section">
        <div class="container">
            <div class="center-title">
                <h2>امکانات سیستم پایش قیمت و مانیتورینگ هوشمند</h2>
                <p>هر آنچه یک فروشنده حرفه‌ای دیجی‌کالا برای مدیریت قیمت‌ها و حفظ فروش خود نیاز دارد</p>
            </div>
            <div class="grid-3-columns">
                <article class="grid-cell">
                    <span class="icon-container">
                        <svg viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z" /></svg>
                    </span>
                    <h3>بررسی سریع ۱۵ دقیقه‌ای</h3>
                    <p>سیستم در تمام ساعات شبانه‌روز و در فواصل کوتاه، قیمت‌ها را مانیتور می‌کند تا تغییر قیمت رقبا در کوتاه‌ترین زمان ممکن به اطلاع شما برسد.</p>
                </article>
                <article class="grid-cell">
                    <span class="icon-container">
                        <svg viewBox="0 0 24 24"><path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z" /></svg>
                    </span>
                    <h3>اعلام آنی با ربات تلگرام</h3>
                    <p>هشدارهای تغییر قیمت، بای‌باکس و فروشندگان جدید مستقیماً در تلگرام شما ارسال می‌شود؛ سریع، رایگان و بدون محدودیت اپراتورهای پیامکی.</p>
                </article>
                <article class="grid-cell">
                    <span class="icon-container">
                        <svg viewBox="0 0 24 24"><path d="M20 18c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 4h16v12H4V4z" /></svg>
                    </span>
                    <h3>لینک مستقیم اصلاح قیمت</h3>
                    <p>درون هر پیام ربات، یک لینک مستقیم به صفحه همان محصول در پنل سایت وجود دارد تا بتوانید در سریع‌ترین زمان ممکن، قیمت خود را ویرایش و اصلاح کنید.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="stats-bar">
        <div class="container stats-table">
            <div class="stat-node">
                <span class="number">۲۴ ساعته</span>
                <span class="desc">پایش منظم، خودکار و شبانه‌روزی قیمت‌ها</span>
            </div>
            <div class="stat-node">
                <span class="number">۱۵ دقیقه</span>
                <span class="desc">بازرسی مداوم و استخراج قیمت رقبا در سریع‌ترین زمان</span>
            </div>
            <div class="stat-node">
                <span class="number">۷ روز تست</span>
                <span class="desc">اعتبار کامل و رایگان برای سنجش سرعت و دقت سیستم</span>
            </div>
        </div>
    </section>

    <section class="section-wrapper">
        <div class="container">
            <div class="center-title">
                <h2>سوالات متداول فروشندگان دیجی‌کالا</h2>
                <p>پاسخ به سوالات کلیدی شما درباره نحوه رصد قیمت‌ها و افزایش فروش با سیستم پایش هوشمند</p>
            </div>
            <div class="faq-block">

                <div class="faq-row">
                    <h3>آیا پایش قیمت‌ها نیاز به نصب نرم‌افزار یا اتصال مداوم اینترنت دارد؟</h3>
                    <p>خیر، تمام فرآیند پایش روی سرورهای ابری ما انجام می‌شود. پس از ثبت لینک محصول در پنل کاربری و اتصال تلگرام، می‌توانید مرورگر خود را ببندید یا اینترنت را قطع کنید؛ سیستم بدون توقف به کار خود ادامه می‌دهد و تغییرات را مستقیماً از طریق ربات تلگرام برای شما می‌فرستد.</p>
                </div>

                <div class="faq-row">
                    <h3>سیستم با چه سرعتی تغییرات قیمت کالاها را شناسایی می‌کند؟</h3>
                    <p>سیستم مانیتورینگ ما به صورت خودکار و منظم، هر ۱۵ دقیقه یک‌بار قیمت محصولات شما و رقبایتان را بررسی می‌کند. به محض اینکه کوچک‌ترین تغییری (قیمت، بای‌باکس یا فروشندگان) نسبت به آخرین پایش ثبت شود، ربات تلگرام فوراً گزارش هشدار را برای شما ارسال خواهد کرد.</p>
                </div>

                <div class="faq-row">
                    <h3>لینک مستقیم ارسال‌شده در پیام تلگرام چه کاربردی دارد؟</h3>
                    <p>درون هر پیام هشدار تلگرام، یک لینک مستقیم و اختصاصی قرار دارد. با کلیک روی آن، مستقیماً به صفحه همان محصول در پنل کاربری هدایت می‌شوید تا بتوانید بدون اتلاف وقت برای جستجوی محصول، قیمت خود را تغییر داده و بای‌باکس را تصاحب کنید.</p>
                </div>

                <div class="faq-row">
                    <h3>چگونه این سیستم به برنده شدن ما در بای‌باکس (Buy Box) کمک می‌کند؟</h3>
                    <p>بزرگ‌ترین عامل برنده شدن در بای‌باکس، داشتن قیمت رقابتی است. این ابزار به شما کمک می‌کند تا به محض اینکه رقیبتان قیمت خود را کاهش داد (حتی در نیمه‌شب)، باخبر شوید و با اصلاح سریع قیمت، جایگاه بای‌باکس و سهم فروش کالا را حفظ کنید.</p>
                </div>

                <div class="faq-row">
                    <h3>آیا برای شروع استفاده از سیستم باید هزینه‌ای پرداخت کنیم؟</h3>
                    <p>خیر، شما می‌توانید از پلن تست ۷ روزه استفاده کنید. در این دوره، سیستم پایش قیمت فعال است تا بتوانید سرعت، دقت و نحوه ارسال هشدارهای تلگرام را کاملاً بسنجید و پس از اطمینان از کارایی ابزار، اشتراک خود را تمدید یا ارتقا دهید.</p>
                </div>

                <div class="faq-row">
                    <h3>محدودیت تعداد لینک‌های ثبت‌شده در هر پلن به چه صورت است؟</h3>
                    <p>در تمامی پلن‌های سیستم پایش (شامل پلن تست و پلن‌های تجاری ۳۰ روزه و ۹۰ روزه)، شما امکان پایش همزمان حداکثر ۲۰ کالا را دارید تا بتوانید به راحتی و بدون محدودیت، تمام کالاهای استراتژیک و پررقابت فروشگاه خود را رصد کنید.</p>
                </div>

            </div>
        </div>
    </section>
</div>

@await Component.InvokeAsync("LatestBlogs")

