<header id="page-topbar">
    <div class="navbar-header">
        <div class="d-flex">
            <div class="navbar-brand-box">
                <a asp-area="UserPanel" asp-controller="Home" asp-action="Index" class="logo logo-light">
                    <span class="logo-sm">
                        <img src="~/assets/image/fav.png" alt="لوگو سایت" height="22">
                    </span>
                    <span class="logo-lg">
                        <img src="~/assets/image/logo.webp" alt="لوگو سایت" height="18">
                    </span>
                </a>
            </div>

            <button type="button" class="btn btn-sm px-3 font-size-24 header-item waves-effect vertical-menu-btn">
                <i class="mdi mdi-menu"></i>
            </button>
        </div>

        <div class="d-flex">
            <div class="dropdown d-inline-block">
                <button type="button" class="btn header-item waves-effect" id="page-header-user-dropdown"
                        data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="mdi mdi-account-circle text-muted align-middle mex-1 fs-30"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end">
                    <a class="dropdown-item" asp-area="UserPanel" asp-controller="User" asp-action="MyInfo">
                        <i class="mdi mdi-account-circle font-size-17 text-muted align-middle mex-1"></i> مشخصات
                    </a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item text-danger" asp-area="" asp-controller="Account" asp-action="Logout"><i class="mdi mdi-power font-size-17 text-muted align-middle mex-1 text-danger"></i> خروج</a>
                </div>
            </div>
        </div>
    </div>
</header>