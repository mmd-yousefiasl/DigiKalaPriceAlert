@using Application.Dtos.Tickets.ClientSide
@using Application.Tools
@using Domain.Enums.Tickets
@model ClientSideTicketDetailsDto

@if (Model == null)
{
    <div class="alert alert-danger text-center font-size-13 border-danger mb-3" role="alert">
        <i class="mdi mdi-alert-circle-outline me-1"></i> اطلاعات تیکت یافت نشد یا دسترسی شما محدود شده است.
    </div>
}
else
{
    string statusBadgeClass = Model.Status switch
    {
        TicketStatusEnum.Open => "bg-dark",
        TicketStatusEnum.Pending => "bg-soft-warning text-warning",
        TicketStatusEnum.Answered => "bg-soft-success text-success",
        TicketStatusEnum.UserReplied => "bg-soft-primary text-primary",
        TicketStatusEnum.Closed => "bg-light text-muted border",
        _ => "bg-light text-dark"
    };

    <div class="card border border-dark mb-3 shadow-sm">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center py-3">
            <div>
                <h5 class="text-dark fw-bold font-size-15 mb-1">@Model.Title</h5>
                <div class="text-muted font-size-12">
                    <span><i class="mdi mdi-folder-outline me-1"></i> دپارتمان: @Model.Category.GetDisplayName()</span>
                    <span class="ms-3"><i class="mdi mdi-calendar-outline me-1"></i> تاریخ ثبت: @Model.CreatedDate.GetDateTime()</span>
                </div>
            </div>
            <div class="mt-2 mt-sm-0">
                <span class="badge @statusBadgeClass font-size-12 px-3 py-2">@Model.Status.GetDisplayName()</span>
            </div>
        </div>
    </div>

    <div class="card border border-dark mb-4 shadow-sm">
        <div class="card-body p-3" style="max-height: 500px; overflow-y: auto; background-color: #fcfcfc;">

            @if (Model.Messages != null && Model.Messages.Any())
            {
                @foreach (var message in Model.Messages)
                {
                    <div class="d-flex mb-3 @(message.IsAdminResponse ? "justify-content-start" : "justify-content-end")">
                        <div class="p-3 shadow-sm"
                             style="max-width: 75%; border-radius: 8px;
                            border: 1px solid @(message.IsAdminResponse ? "#dee2e6" : "#e9ecef");
                            background-color: @(message.IsAdminResponse ? "#ffffff" : "#f1f1f1");">

                            <div class="d-flex justify-content-between align-items-center mb-2 font-size-11 text-muted border-bottom pb-1">
                                <span class="fw-bold @(message.IsAdminResponse ? "text-primary" : "text-dark")">
                                    <i class="mdi @(message.IsAdminResponse ? "mdi-account-star" : "mdi-account") me-1"></i>
                                    @(message.IsAdminResponse ? "پاسخ پشتیبان" : "شما")
                                </span>
                                <span>@message.CreatedDate.GetDateTime()</span>
                            </div>

                            <div class="text-dark font-size-13 text-justify lh-base" style="white-space: pre-line;">
                                @message.Text
                            </div>

                            @if (!string.IsNullOrEmpty(message.AttachmentPath))
                            {
                                <div class="mt-2 pt-2 border-top border-light text-start">
                                    <a asp-area="UserPanel" asp-controller="Ticket" asp-action="GetTicketAttachment" asp-route-fileName="@message.AttachmentPath"
                                       target="_blank" class="btn btn-sm btn-link font-size-11 p-0 text-decoration-none text-dark fw-bold">
                                        <i class="mdi mdi-paperclip me-1 text-muted"></i> مشاهده فایل پیوست
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-4 font-size-13">هیچ پیامی در این تیکت یافت نشد.</div>
            }
        </div>
    </div>
}