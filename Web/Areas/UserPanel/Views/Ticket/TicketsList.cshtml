@using Application.Dtos.Tickets.ClientSide
@using Application.Tools
@using Domain.Enums.Tickets
@model ClientSideFilterTicketsDto

@{
    ViewData["Title"] = "لیست تیکت‌های پشتیبانی";
}

<div class="dp-tickets">
    <div class="container-fluid">

        <div class="row">
            <div class="col-sm-6">
                <div class="page-title-box">
                    <h4>پنل کاربری</h4>
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a></li>
                        <li class="breadcrumb-item active">@ViewData["Title"]</li>
                    </ol>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <form novalidate asp-area="UserPanel" asp-controller="Ticket" method="get" asp-action="TicketsList" id="search-form">
                    <input type="hidden" asp-for="Page" id="Page" />
                    <div class="row g-3">
                        <div class="col-12 col-md-3">
                            <label class="form-label" asp-for="Search"></label>
                            <input type="text" class="form-control" asp-for="Search" autocomplete="off" placeholder="عنوان تیکت...">
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" asp-for="Category"></label>
                            <select class="form-control form-select" asp-for="Category" asp-items="@Html.GetEnumSelectList<TicketCategoryEnum>()">
                                <option value="">همه دسته‌ها</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label" asp-for="Priority"></label>
                            <select class="form-control form-select" asp-for="Priority" asp-items="@Html.GetEnumSelectList<TicketPriorityEnum>()">
                                <option value="">همه اولویت‌ها</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label" asp-for="Status"></label>
                            <select class="form-control form-select" asp-for="Status" asp-items="@Html.GetEnumSelectList<TicketStatusEnum>()">
                                <option value="">همه وضعیت‌ها</option>
                            </select>
                        </div>
                        <div class="col-12 d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                            <button class="btn btn-dark px-4" type="submit">
                                <i class="mdi mdi-magnify me-1"></i> جستجو و فیلتر
                            </button>
                            <a asp-area="UserPanel" asp-controller="Ticket" asp-action="CreateNewTicket" class="btn btn-outline-dark px-3">
                                <i class="mdi mdi-plus me-1"></i> ثبت تیکت جدید
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @if (Model?.Entities?.Any() ?? false)
        {
            int counter = 0;

            <div class="card d-none d-md-block">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-centered mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 50px;" class="text-center">#</th>
                                    <th>عنوان تیکت</th>
                                    <th>دسته بندی</th>
                                    <th>اولویت</th>
                                    <th>وضعیت</th>
                                    <th>آخرین بروزرسانی</th>
                                    <th class="text-center" style="width: 100px;">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Entities)
                                {
                                    counter++;

                                    string badgeClass = item.Status switch
                                    {
                                        TicketStatusEnum.Open => "bg-dark",
                                        TicketStatusEnum.Pending => "bg-soft-warning text-warning",
                                        TicketStatusEnum.Answered => "bg-soft-success text-success",
                                        TicketStatusEnum.UserReplied => "bg-soft-primary text-primary",
                                        TicketStatusEnum.Closed => "bg-light text-muted border",
                                        _ => "bg-light text-dark"
                                    };

                                    <tr>
                                        <td class="text-center text-muted">@item.Id</td>
                                        <td class="fw-bold text-dark">
                                            <a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketDetails" asp-route-id="@item.Id" class="text-dark decoration-none">@item.Title</a>
                                        </td>
                                        <td><span class="badge bg-light">@item.Category.GetDisplayName()</span></td>
                                        <td>
                                            @switch (item.Priority)
                                            {
                                                case TicketPriorityEnum.High:
                                                    <span class="badge bg-soft-danger text-danger">فوری</span>
                                                    break;
                                                case TicketPriorityEnum.Medium:
                                                    <span class="badge bg-soft-warning text-warning">متوسط</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light">کم</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            <span class="badge @badgeClass">@item.Status.GetDisplayName()</span>
                                        </td>
                                        <td class="text-muted">@item.LastUpdatedDate.GetDateTime()</td>
                                        <td class="text-center">
                                            <a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketDetails" asp-route-id="@item.Id" class="btn btn-dark btn-sm">
                                                مشاهده
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-block d-md-none">
                @foreach (var item in Model.Entities)
                {
                    string badgeClass = item.Status switch
                    {
                        TicketStatusEnum.Open => "bg-dark",
                        TicketStatusEnum.Pending => "bg-soft-warning text-warning",
                        TicketStatusEnum.Answered => "bg-soft-success text-success",
                        TicketStatusEnum.UserReplied => "bg-soft-primary text-primary",
                        TicketStatusEnum.Closed => "bg-light text-muted border",
                        _ => "bg-light text-dark"
                    };

                    string statusModifier = item.Status switch
                    {
                        TicketStatusEnum.Open => "tr-card--open",
                        TicketStatusEnum.Pending => "tr-card--pending",
                        TicketStatusEnum.Answered => "tr-card--answered",
                        TicketStatusEnum.UserReplied => "tr-card--userreplied",
                        TicketStatusEnum.Closed => "tr-card--closed",
                        _ => "tr-card--closed"
                    };

                    <div class="tr-card @statusModifier cursor-pointer"
                         onclick="window.location.href='/user/ticket-details?id=@item.Id'">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark" style="font-size: 14px;">@item.Title</span>
                            <span class="badge @badgeClass">@item.Status.GetDisplayName()</span>
                        </div>

                        <div class="d-flex justify-content-between text-muted mb-2" style="font-size: 12px;">
                            <span><i class="mdi mdi-folder-outline me-1"></i> @item.Category.GetDisplayName()</span>
                            <span>
                                اولویت:
                                <b class="@(item.Priority == TicketPriorityEnum.High ? "text-danger" : "text-dark")">
                                    @item.Priority.GetDisplayName()
                                </b>
                            </span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center text-muted border-top pt-2 mt-2" style="font-size: 11px;">
                            <span>شماره تیکت: <b class="text-dark">#@item.Id</b></span>
                            <span>@item.LastUpdatedDate.GetDateTime() <i class="mdi mdi-clock-outline ms-1"></i></span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body p-0">
                    <partial name="_NotFoundPartial" />
                </div>
            </div>
        }

        <div class="mt-3">
            <partial name="_Paging" model="@Model.GetCurrentPaging()" />
        </div>
    </div>
</div>