@using Application.Dtos.Tickets.ClientSide
@model ClientSideSendTicketMessageDto

@{
    ViewData["Title"] = "جزئیات و گفتگو تیکت";
}

<div class="dp-ticket-details">
    <div class="container-fluid">

        <div class="row">
            <div class="col-sm-6">
                <div class="page-title-box">
                    <h4>پنل کاربری</h4>
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a></li>
                        <li class="breadcrumb-item"><a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketsList">تیکت‌های پشتیبانی</a></li>
                        <li class="breadcrumb-item active">گفتگو</li>
                    </ol>
                </div>
            </div>
        </div>

        @if (Model == null)
        {
            <div class="alert alert-danger text-center mb-3" role="alert">
                <i class="mdi mdi-alert-circle-outline me-1"></i> اطلاعات درخواست شده معتبر نمی‌باشد یا فرم با خطا مواجه شده است.
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12 col-lg-9">

                    @await Component.InvokeAsync("ClientSideTicketDetails", new { ticketId = Model.TicketId })

                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title mb-3">
                                <i class="mdi mdi-reply me-1 text-muted"></i> ارسال پاسخ جدید
                            </h5>

                            <form asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketDetails" method="post" enctype="multipart/form-data">
                                <input type="hidden" asp-for="TicketId" />

                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label" asp-for="MessageText"></label>
                                        <textarea class="form-control" asp-for="MessageText" rows="4" placeholder="متن پاسخ خود را بنویسید..."></textarea>
                                        <span asp-validation-for="MessageText" class="text-danger mt-1 d-block"></span>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label" asp-for="Attachment"></label>
                                        <input type="file" class="form-control" asp-for="Attachment">
                                        <span asp-validation-for="Attachment" class="text-danger mt-1 d-block"></span>
                                    </div>

                                    <div class="col-12 text-start mt-3">
                                        <button class="btn-submit btn btn-dark px-4" type="submit">
                                            ارسال پاسخ
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>

                <div class="col-12 col-lg-3 mt-3 mt-lg-0">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">عملیات تیکت</h6>

                            <div class="d-flex flex-column flex-row gap-2 my-2">
                                <form asp-area="UserPanel"
                                      asp-controller="Ticket"
                                      asp-action="CloseTicket"
                                      asp-route-id="@Model.TicketId"
                                      method="post"
                                      onclick="ConfirmDelete(this)"
                                      class="btn btn-danger btn-sm d-flex align-items-center justify-content-center m-0 flex-grow-1">

                                    <i class="mdi mdi-lock-outline me-1"></i>
                                    <span>بستن نهایی تیکت</span>
                                </form>

                                <a asp-area="UserPanel"
                                   asp-controller="Ticket"
                                   asp-action="TicketsList"
                                   class="btn btn-outline-dark btn-sm d-flex align-items-center justify-content-center flex-grow-1">

                                    <span>بازگشت به لیست</span>
                                    <i class="mdi mdi-arrow-left ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>