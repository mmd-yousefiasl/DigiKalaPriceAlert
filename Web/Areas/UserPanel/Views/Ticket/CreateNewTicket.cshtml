@using Application.Dtos.Tickets.ClientSide
@using Domain.Enums.Tickets
@model ClientSideCreateNewTicketDto

@{
    ViewData["Title"] = "ثبت تیکت پشتیبانی جدید";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>پنل کاربری</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a></li>
                    <li class="breadcrumb-item"><a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketsList">تیکت‌های پشتیبانی</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-9">
            <div class="card border border-dark shadow-sm">
                <div class="card-body">
                    <h5 class="card-title font-size-14 text-dark mb-3">
                        <i class="mdi mdi-plus-circle-outline me-1 text-muted"></i> ایجاد تیکت جدید
                    </h5>
                    <hr class="border-dark-subtle" />

                    <form onsubmit="submitAnimation()" asp-area="UserPanel" asp-controller="Ticket" asp-action="CreateNewTicket" method="post" enctype="multipart/form-data">
                        <div class="row g-3">

                            <div class="col-12">
                                <label class="form-label font-size-12 fw-bold text-dark" asp-for="Title"></label>
                                <input type="text" class="form-control border-dark-subtle font-size-13" asp-for="Title" autocomplete="off" placeholder="موضوع تیکت خود را کوتاه و واضح بنویسید...">
                                <span asp-validation-for="Title" class="text-danger font-size-11 mt-1 d-block"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label font-size-12 fw-bold text-dark" asp-for="Category"></label>
                                <select class="form-control form-select border-dark-subtle font-size-13" asp-for="Category" asp-items="@Html.GetEnumSelectList<TicketCategoryEnum>()">
                                    <option value="">انتخاب دپارتمان...</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger font-size-11 mt-1 d-block"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label font-size-12 fw-bold text-dark" asp-for="Priority"></label>
                                <select class="form-control form-select border-dark-subtle font-size-13" asp-for="Priority" asp-items="@Html.GetEnumSelectList<TicketPriorityEnum>()">
                                    <option value="">انتخاب اولویت...</option>
                                </select>
                                <span asp-validation-for="Priority" class="text-danger font-size-11 mt-1 d-block"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label font-size-12 fw-bold text-dark" asp-for="MessageText"></label>
                                <textarea class="form-control border-dark-subtle font-size-13" asp-for="MessageText" rows="6" placeholder="توضیحات کامل مشکل یا درخواست خود را وارد کنید..."></textarea>
                                <span asp-validation-for="MessageText" class="text-danger font-size-11 mt-1 d-block"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label font-size-12 fw-bold text-dark" asp-for="Attachment"></label>
                                <input type="file" class="form-control border-dark-subtle font-size-13" asp-for="Attachment">
                                <div class="text-muted font-size-11 mt-1">
                                    <i class="mdi mdi-information-outline me-1"></i> پسوندهای مجاز: png, jpg, jpeg, webp (حداکثر حجم مجاز:500 کیلوبایت)
                                </div>
                                <span asp-validation-for="Attachment" class="text-danger font-size-11 mt-1 d-block"></span>
                            </div>

                            <div class="col-12 text-start mt-4">
                                <a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketsList" class="btn btn-outline-secondary btn-sm px-4 font-size-13 me-2">
                                    انصراف و بازگشت
                                </a>
                                <button class="btn-submit btn btn-dark btn-sm px-4 font-size-13" type="submit">
                                    <i class="mdi mdi-check me-1"></i> ثبت و ارسال تیکت
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-3 d-lg-block">
            <div class="card border border-dark bg-light shadow-sm">
                <div class="card-body">
                    <h6 class="font-size-13 text-dark fw-bold mb-2">راهنمای ارسال تیکت</h6>
                    <p class="text-muted font-size-12 lh-base mb-0">
                        لطفاً قبل از ارسال تیکت، دپارتمان مربوطه را به درستی انتخاب کنید تا فرآیند پاسخ‌گویی در سریع‌ترین زمان ممکن انجام شود. از ارسال تیکت‌های مکرر برای یک موضوع خودداری فرمایید.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>