@using Application.Dtos.Tickets.ClientSide
@using Domain.Enums.Tickets
@model ClientSideCreateNewTicketDto

@{
    ViewData["Title"] = "ثبت تیکت پشتیبانی جدید";
}

<div class="dp-ticket-create">
    <div class="container-fluid">

        <div class="row">
            <div class="col-sm-6">
                <div class="page-title-box">
                    <h4>پنل کاربری</h4>
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a></li>
                        <li class="breadcrumb-item"><a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketsList">تیکت‌های پشتیبانی</a></li>
                        <li class="breadcrumb-item active">@ViewData["Title"]</li>
                    </ol>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 col-lg-9">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            <i class="mdi mdi-plus-circle-outline me-1 text-muted"></i> ایجاد تیکت جدید
                        </h5>
                        <hr class="card-divider" />

                        <form asp-area="UserPanel" asp-controller="Ticket" asp-action="CreateNewTicket" method="post" enctype="multipart/form-data">
                            <div class="row g-3">

                                <div class="col-12">
                                    <label class="form-label" asp-for="Title"></label>
                                    <input type="text" class="form-control" asp-for="Title" autocomplete="off" placeholder="موضوع تیکت خود را کوتاه و واضح بنویسید...">
                                    <span asp-validation-for="Title" class="text-danger mt-1 d-block"></span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label" asp-for="Category"></label>
                                    <select class="form-control form-select" asp-for="Category" asp-items="@Html.GetEnumSelectList<TicketCategoryEnum>()">
                                        <option value="">انتخاب دپارتمان...</option>
                                    </select>
                                    <span asp-validation-for="Category" class="text-danger mt-1 d-block"></span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label class="form-label" asp-for="Priority"></label>
                                    <select class="form-control form-select" asp-for="Priority" asp-items="@Html.GetEnumSelectList<TicketPriorityEnum>()">
                                        <option value="">انتخاب اولویت...</option>
                                    </select>
                                    <span asp-validation-for="Priority" class="text-danger mt-1 d-block"></span>
                                </div>

                                <div class="col-12">
                                    <label class="form-label" asp-for="MessageText"></label>
                                    <textarea class="form-control" asp-for="MessageText" rows="6" placeholder="توضیحات کامل مشکل یا درخواست خود را وارد کنید..."></textarea>
                                    <span asp-validation-for="MessageText" class="text-danger mt-1 d-block"></span>
                                </div>

                                <div class="col-12">
                                    <label class="form-label" asp-for="Attachment"></label>
                                    <input type="file" class="form-control" asp-for="Attachment">
                                    <div class="form-hint mt-1">
                                        <i class="mdi mdi-information-outline me-1"></i> پسوندهای مجاز: png, jpg, jpeg, webp (حداکثر حجم مجاز:500 کیلوبایت)
                                    </div>
                                    <span asp-validation-for="Attachment" class="text-danger mt-1 d-block"></span>
                                </div>

                                <div class="col-12 mt-4">
                                    <div class="d-flex flex-column-reverse flex-sm-row justify-content-start gap-2">

                                        <a asp-area="UserPanel" asp-controller="Ticket" asp-action="TicketsList"
                                           class="btn btn-outline-secondary px-4 w-100 w-sm-auto">
                                            انصراف و بازگشت
                                        </a>

                                        <button class="btn-submit btn btn-dark px-4 w-100 w-sm-auto" type="submit" id="btnSubmitTicket">
                                            <span class="btn-content-wrapper">
                                                <i class="mdi mdi-check me-1"></i>
                                                <span class="btn-text">ثبت و ارسال تیکت</span>
                                            </span>
                                            <span class="btn-spinner d-none">
                                                <i class="mdi mdi-loading mdi-spin"></i>
                                            </span>
                                        </button>

                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-3 d-lg-block">
                <div class="card shadow-sm bg-light">
                    <div class="card-body">
                        <h6 class="fw-bold mb-2">راهنمای ارسال تیکت</h6>
                        <p class="lh-base mb-0">
                            لطفاً قبل از ارسال تیکت، دپارتمان مربوطه را به درستی انتخاب کنید تا فرآیند پاسخ‌گویی در سریع‌ترین زمان ممکن انجام شود. از ارسال تیکت‌های مکرر برای یک موضوع خودداری فرمایید.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>