@using Application.Dtos.Users.ClientSide
@using Application.Tools
@model ClientSideUserDetailsDto

@{
    ViewData["Title"] = "پنل کاربری";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>پنل کاربری</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-4 col-lg-5">

            <div class="card text-center border border-dark" style="border-top: 4px solid #000000 !important;">
                <div class="card-body">
                    <div class="mb-3">
                        <div class="avatar-sm mx-auto bg-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                            @if (!string.IsNullOrEmpty(Model.FirstName))
                            {
                                <span class="text-white font-size-24 fw-bold">@Model.FirstName.FirstOrDefault()</span>
                            }
                            else
                            {
                                <i class="mdi mdi-account text-white font-size-24"></i>
                            }
                        </div>
                    </div>

                    @if (string.IsNullOrEmpty(Model.FirstName) && string.IsNullOrEmpty(Model.LastName))
                    {
                        <h5 class="font-size-16 mb-1 text-dark fw-bold">کاربر بدون نام</h5>
                    }
                    else
                    {
                        <h5 class="font-size-16 mb-1 text-dark fw-bold">
                            @(Model.FirstName ?? "") @(Model.LastName ?? "")
                        </h5>
                    }

                    <p class="font-size-13 mb-3">
                        @if (!string.IsNullOrEmpty(Model.Username))
                        {
                            <span class="text-muted">@@@Model.Username</span>
                        }
                        else
                        {
                            <span class="text-muted font-size-12 italic">بدون نام کاربری</span>
                        }
                    </p>

                    <div>
                        <span class="badge bg-dark px-3 py-2 font-size-12">
                            حساب کاربری @(Model.IsUserBanned ? "غیرفعال" : "فعال")
                        </span>
                    </div>
                </div>
            </div>

            <div class="card border border-dark">
                <div class="card-body">
                    <h4 class="card-title mb-4 pb-2 border-bottom text-dark font-size-14">
                        <i class="mdi mdi-information-outline me-1 text-muted"></i> اطلاعات ارتباطی و سیستم
                    </h4>

                    <div class="table-responsive">
                        <table class="table table-borderless mb-0 font-size-13">
                            <tbody>
                                <tr>
                                    <th scope="row" class="text-muted ps-0" style="width: 40%;">شماره موبایل:</th>
                                    <td class="text-end fw-bold text-dark" dir="ltr">@Model.Mobile</td>
                                </tr>
                                <tr>
                                    <th scope="row" class="text-muted ps-0">آیدی چت تلگرام:</th>
                                    <td class="text-end text-dark">
                                        @if (Model.ChatId is null)
                                        {
                                            <span class="text-muted font-size-12">متصل نشده</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold">@Model.ChatId</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row" class="text-muted ps-0">نقش‌های کاربری:</th>
                                    <td class="text-end">
                                        @if (Model.UserRoles?.Any() ?? false)
                                        {
                                            foreach (var item in Model.UserRoles)
                                            {
                                                <span class="badge border border-dark text-dark bg-transparent me-1">@item.Title</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">کاربر عادی</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-8 col-lg-7">

            <div class="card border border-dark" style="border-top: 4px solid #000000 !important;">
                <div class="card-body">
                    <h4 class="card-title mb-3 pb-2 border-bottom text-dark font-size-14">
                        <i class="mdi mdi-star-outline me-1 text-muted"></i> وضعیت اشتراک فعلی
                    </h4>
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-3 mb-md-0">
                            <span class="text-muted font-size-13 d-block mb-1">عنوان پلن:</span>
                            <h5 class="font-size-15 fw-bold text-dark mb-0">@(Model.SubscriptionPlanName ?? "بدون پلن فعال")</h5>
                        </div>
                        <div class="col-md-4 mb-3 mb-md-0">
                            <span class="text-muted font-size-13 d-block mb-1">تاریخ پایان اشتراک:</span>
                            <h5 class="font-size-15 fw-bold text-dark mb-0">
                                @if (Model.SubscriptionEndDate is null)
                                {
                                    <span class="text-muted font-size-14">—</span>
                                }
                                else
                                {
                                    @Model.SubscriptionEndDate?.GetDateTime()
                                }
                            </h5>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <span class="text-muted font-size-13 d-block mb-1">شناسه پلن:</span>
                            <span class="badge bg-dark font-size-11">ID: @(Model.SubscriptionPlanId.ToString() ?? "—")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border border-dark">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-sm-7 mb-3 mb-sm-0">
                            <div class="d-flex align-items-center">
                                <div class="avatar-xs me-3 bg-dark text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="mdi mdi-wallet font-size-20"></i>
                                </div>
                                <div>
                                    <span class="text-muted font-size-13 d-block mb-1">موجودی فعلی کیف پول:</span>
                                    <h4 class="font-size-20 fw-bold text-dark mb-0">@Model.Balance.ToTomanFormat() <span class="font-size-13 fw-normal text-muted">تومان</span></h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-5 text-sm-end">
                            <a asp-area="UserPanel" asp-controller="User" asp-action="Deposit" class="btn btn-dark waves-effect waves-light">
                                <i class="mdi mdi-plus-circle me-1"></i> افزایش موجودی
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @await Component.InvokeAsync("ClientSideLatestBalanceTransactions")
        </div>
    </div>
</div>