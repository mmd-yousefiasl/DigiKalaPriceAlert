@{
    ViewData["Title"] = "اعتبار اشتراک شما به پایان رسیده است!";
}

<div class="container-fluid">
    <div class="row justify-content-center align-items-center" style="min-height: 75vh;">
        <div class="col-12 col-md-6 col-lg-5 text-center">

            <div class="avatar-md mx-auto mb-4 bg-soft-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 110px; height: 110px;">
                <i class="mdi mdi-clock-alert-outline text-danger" style="font-size: 54px;"></i>
            </div>

            <h3 class="font-size-18 text-dark fw-bold mb-2">اعتبار اشتراک شما به پایان رسیده است!</h3>

            <p class="text-muted font-size-13 mb-4 mx-auto" style="max-width: 380px; line-height: 1.8;">
                با تشکر از همراهی شما با
                @SiteTools.SiteName
                ؛ مهلت استفاده از پلن فعلی شما منقضی شده است. برای ادامه مانیتورینگ خودکار محصولات و دریافت اعلان‌های کاهش قیمت، لطفاً اشتراک خود را تمدید کنید
                .
            </p>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2 max-width-320 mx-auto">
                <a asp-area="" asp-controller="Subscription" asp-action="Pricing" class="btn btn-danger btn-md px-4 py-2 font-size-13 rounded-3 shadow-sm flex-grow-1">
                    <i class="mdi mdi-wallet-membership me-1 align-middle font-size-16"></i>
                    <span class="align-middle">مشاهده و خرید پلن‌های اشتراک</span>
                </a>

                <a asp-area="UserPanel" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-md px-3 py-2 font-size-13 rounded-3">
                    داشبورد
                </a>
            </div>
        </div>
    </div>
</div>