@using Application.Dtos.Products.ClientSide
@model ClientSideCreateNewProductDto
@{
    ViewData["Title"] = "افزودن محصول جدید";
}

@section HeaderReferences {
    <link rel="stylesheet" href="/css/UserPanel/add-product.css" asp-append-version="true" type="text/css" />
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت محصولات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a></li>
                    <li class="breadcrumb-item"><a asp-area="UserPanel" asp-controller="Product" asp-action="ProductsList">لیست محصولات</a></li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="add-card mb-3">
                <div class="p-4 p-card">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px; border-radius: 14px; background: #f3f4f6;">
                            <i class="mdi mdi-magnify-plus-outline font-size-28 text-dark"></i>
                        </div>
                        <h5 class="fw-bold font-size-15 text-dark mb-1">افزودن محصول جدید</h5>
                        <p class="text-muted font-size-12 mb-0">لینک محصول دیجی‌کالا را وارد کنید تا تنوع‌ها و فروشندگان آن نمایش داده شوند</p>
                    </div>

                    <form id="searchForm" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <div class="input-icon-wrapper flex-grow-1">
                            <i class="mdi mdi-link-variant input-icon"></i>
                            <input type="text" id="urlInput" class="add-input" placeholder="https://digikala.com/product/dkp-12345" autocomplete="off" required />
                        </div>
                        <button type="submit" class="submit-btn btn-submit mb-0" style="width: auto; padding: 0 20px;">
                            <i class="mdi mdi-magnify font-size-16"></i>
                            جستجو
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 16px; border: none;">
            <div class="modal-header" style="border-bottom: 1px solid #f0f0f0; padding: 20px;">
                <h5 class="modal-title fw-bold font-size-14" id="productModalLabel">انتخاب فروشنده برای رصد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="productModalBody" style="padding: 20px; max-height: 60vh; overflow-y: auto;">
                <!-- Content will be injected here -->
            </div>
            <div class="modal-footer" style="border-top: 1px solid #f0f0f0; padding: 15px 20px;">
                <a asp-area="UserPanel" asp-controller="Product" asp-action="ProductsList" class="btn btn-sm btn-dark" style="border-radius: 8px;">
                    <i class="mdi mdi-format-list-bulleted me-1"></i> بازگشت به لیست
                </a>
            </div>
        </div>
    </div>
</div>

@section FooterReferences {
    <script asp-append-version="true" src="/js/Admin/add-new-product.js"></script>
}