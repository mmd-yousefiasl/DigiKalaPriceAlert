@using Application.Dtos.Products.ClientSide
@model ClientSideCreateNewProductDto

@{
    ViewData["Title"] = "افزودن محصول جدید";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت محصولات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Product" asp-action="ProductsList">لیست محصولات</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card border border-dark rounded-3 shadow-sm" style="border-radius: 4px !important;">
                <div class="card-body p-4">

                    <form asp-area="UserPanel" asp-controller="Product" asp-action="AddNewProduct" method="post" onsubmit="submitAnimation()">

                        <div class="form-group mb-4">
                            <label for="ProductIdentifier" class="form-label fw-bold text-dark font-size-12 mb-2">
                                لینک محصول یا شناسه کالا (DKP ID)
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light border-dark-subtle text-muted" style="border-left: 0 !important;">
                                    <i class="mdi mdi-link-variant font-size-17"></i>
                                </span>

                                <input type="text"
                                       asp-for="Url"
                                       class="form-control border-dark-subtle font-size-13 py-2"
                                       style="border-right: 0 !important;"
                                       placeholder="مثلا: https://www.digikala.com/... یا dkp-12345"
                                       autocomplete="off" />
                            </div>
                            <span class="text-danger font-size-11 mt-1 d-block" asp-validation-for="Url"></span>

                            <div class="form-text text-muted font-size-11 mt-2.5 d-flex align-items-start">
                                <i class="mdi mdi-information-outline text-dark me-1 font-size-14"></i>
                                <span>شما می‌توانید لینک کامل صفحه محصول یا صرفاً شناسه عددی آن را وارد کنید. سیستم به صورت خودکار اطلاعات را استخراج خواهد کرد.</span>
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row gap-2 pt-3 border-top border-light-subtle">
                            <button type="submit" class="btn-submit btn btn-dark btn-sm px-4 py-2 flex-grow-1 font-size-13">
                                <i class="mdi mdi-magnify-plus me-1 align-middle font-size-15"></i>
                                <span class="align-middle">بررسی و شروع مانیتورینگ</span>
                            </button>

                            <a asp-area="UserPanel" asp-controller="Product" asp-action="ProductsList"
                               class="btn btn-outline-dark btn-sm px-4 py-2 font-size-13">
                                انصراف
                            </a>
                        </div>

                    </form>

                </div>
            </div>

            <div class="card border border-dark rounded-3 mt-3 shadow-sm" style="background: #ffffff; border-radius: 4px !important;">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="avatar-sm bg-dark rounded-circle d-flex align-items-center justify-content-center text-white me-3" style="width: 40px; height: 40px; min-width: 40px;">
                        <i class="mdi mdi-robot-outline font-size-20"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="font-size-13 text-dark fw-bold mb-1">
                            مکانیزم هوشمند
                            @SiteTools.SiteName
                        </h6>
                        <p class="text-muted font-size-11 mb-0" style="line-height: 1.5;">
                            به محض کاهش قیمت،
                            @SiteTools.SiteName
                            تغییرات را به صورت آنی به شما اعلان خواهد کرد.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>