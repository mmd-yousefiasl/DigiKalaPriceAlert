@using Application.Dtos.Products.ClientSide
@using Application.Tools
@model ClientSideProductDetailsDto

@{
    ViewData["Title"] = "جزئیات محصول";
}

@section HeaderReferences {
    <link rel="stylesheet" href="/css/UserPanel/product-details.css" type="text/css" asp-append-version="true" />
}

<div class="container-fluid">

    @* ── Breadcrumb ────────────────────────────────────── *@
    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت محصولات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Product" asp-action="ProductsList">لیست محصولات</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    @* ── Product Hero ──────────────────────────────────── *@
    <div class="pd-card product-hero mb-3">
        <div class="p-3 p-md-4">
            <div class="d-flex gap-3 align-items-start">

                <div class="product-image-frame flex-shrink-0">
                    <img src="@Model.ImageUrl" alt="@Model.Title">
                </div>

                <div class="flex-grow-1 min-width-0">

                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <span class="badge bg-dark text-white font-size-10 px-2 py-1 rounded-pill">مانیتور فعال</span>
                        <span class="badge bg-light text-muted border font-size-10 px-2 py-1 rounded-pill">dkp-@Model.DigiKalaId</span>
                    </div>

                    <h4 class="text-dark fw-bold font-size-14 font-size-md-15 mb-2" style="line-height: 1.7;">
                        @Model.Title
                    </h4>

                    <div class="d-flex flex-wrap align-items-center gap-2 font-size-12 text-muted">
                        @* Color dots *@
                        <div class="d-flex align-items-center gap-1">
                            @foreach (var cg in Model.ColorGroups.Take(5))
                            {
                                @if (cg.ColorHex is not null)
                                {
                                    <span class="cd" style="background-color: @cg.ColorHex;" title="@cg.ColorName"></span>
                                }
                            }
                            @if (Model.ColorGroups.Count > 5)
                            {
                                <span class="text-muted font-size-10">+@(Model.ColorGroups.Count - 5)</span>
                            }
                        </div>
                        <span>·</span>
                        <span>@Model.ColorGroups.Count رنگ</span>
                        <span>·</span>
                        <span>@Model.TotalSellersCount فروشنده</span>
                        <span>·</span>
                        <span><i class="mdi mdi-clock-outline font-size-11"></i> @Model.LastUpdatedDate.ToPersianRelativeTime()</span>
                    </div>

                    <div class="mt-2">
                        <a href="@Model.Url" target="_blank" class="btn btn-sm btn-outline-dark rounded-pill px-3 font-size-11">
                            <i class="mdi mdi-open-in-new me-1"></i> مشاهده در دیجی‌کالا
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Stats ─────────────────────────────────────────── *@
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <div class="stat-pill">
            <div class="stat-label">ارزان‌ترین</div>
            <div class="stat-value">
                @if (Model.LowestCurrentPrice > 0)
                {
                    @Model.LowestCurrentPrice.ToTomanFormat()
                    <span class="stat-unit">ت</span>
                }
                else
                {
                    @:—
                }
            </div>
        </div>
        <div class="stat-pill">
            <div class="stat-label">گران‌ترین</div>
            <div class="stat-value">
                @if (Model.HighestCurrentPrice > 0)
                {
                    @Model.HighestCurrentPrice.ToTomanFormat()
                    <span class="stat-unit">ت</span>
                }
                else
                {
                    @:—
                }
            </div>
        </div>
        <div class="stat-pill">
            <div class="stat-label">اختلاف</div>
            <div class="stat-value">
                @if (Model.LowestCurrentPrice > 0 && Model.HighestCurrentPrice > Model.LowestCurrentPrice)
                {
                    @((Model.HighestCurrentPrice - Model.LowestCurrentPrice).ToTomanFormat())
                    <span class="stat-unit">ت</span>
                }
                else
                {
                    @:—
                }
            </div>
        </div>
        <div class="stat-pill">
            <div class="stat-label">تغییرات</div>
            <div class="stat-value">
                @Model.ColorGroups.Sum(g => g.RecentHistory.Count) <span class="stat-unit">مورد</span>
            </div>
        </div>
    </div>

    @* ── Color Groups (Sellers per Color) ──────────────── *@
    <div class="pd-card mb-3">
        <div class="section-header">
            <div class="section-title">
                <i class="mdi mdi-store-outline"></i>
                رقابت فروشندگان
            </div>
            <span class="section-count">@Model.ColorGroups.Count رنگ · @Model.TotalSellersCount فروشنده</span>
        </div>

        <div class="p-2 p-md-3">
            @{
                int colorIdx = 0;
            }
            @foreach (var group in Model.ColorGroups)
            {
                colorIdx++;
                var winner = group.Winner;
                if (winner is null) continue;

                var hasOthers = group.OtherSellers.Any();

                <div class="color-section">

                    @* ── Color Header (Winner) ── *@
                    <div class="color-header @(hasOthers ? "" : "")"
                         id="ch-@colorIdx"
                        @(hasOthers ? $"onclick=toggleColor({colorIdx})" : "")
                         style="@(hasOthers ? "cursor:pointer;" : "")">

                        <div class="ch-left">
                            @if (group.ColorHex is not null)
                            {
                                <span class="cd cd-lg" style="background-color: @group.ColorHex;"></span>
                            }
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold font-size-13">@group.ColorName</span>
                                    @if (group.LastUpdatedDate > DateTime.MinValue)
                                    {
                                        <span class="font-size-10 text-muted">
                                            <i class="mdi mdi-clock-outline font-size-10"></i>
                                            @group.LastUpdatedDate.ToPersianRelativeTime()
                                        </span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <span class="winner-badge">
                                        <i class="mdi mdi-trophy font-size-11"></i>
                                        @winner.SellerName
                                    </span>
                                    @if (winner.SellerRating.HasValue && winner.SellerRating > 0)
                                    {
                                        <span class="rating-badge">
                                            <i class="mdi mdi-star"></i> @winner.SellerRating.Value.ToString("N0")
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="ch-right">
                            <div class="text-end">
                                <div>
                                    @if (winner.CurrentPrice > 0)
                                    {
                                        <span class="fw-bold font-size-14">@winner.CurrentPrice.ToTomanFormat()</span>
                                        <span class="font-size-10 text-muted">ت</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">ناموجود</span>
                                    }
                                </div>
                                @{
                                    var wChange = winner.PriceChange;
                                    var wPercent = winner.PriceChangePercent;
                                }
                                @if (wChange.HasValue && wChange != 0)
                                {
                                    var wUp = wChange > 0;
                                    <span class="price-change @(wUp ? "up" : "down")">
                                        @(wUp ? "▲" : "▼") @Math.Abs(wPercent ?? 0).ToString("N1")%
                                    </span>
                                }
                            </div>

                            @if (hasOthers)
                            {
                                <div class="d-flex align-items-center gap-1">
                                    <span class="font-size-11 text-muted">+@group.OtherSellers.Count</span>
                                    <i class="mdi mdi-chevron-down chevron-icon" id="chev-@colorIdx"></i>
                                </div>
                            }
                        </div>
                    </div>

                    @* ── Other Sellers (Collapsible) ── *@
                    @if (hasOthers)
                    {
                        <div class="color-body" id="cb-@colorIdx">
                            @foreach (var seller in group.OtherSellers)
                            {
                                var sChange = seller.PriceChange;
                                var sPercent = seller.PriceChangePercent;

                                <div class="seller-row">
                                    <div class="sr-info">
                                        <div class="sr-name">@seller.SellerName</div>
                                        <div class="sr-meta">
                                            @if (seller.SellerRating.HasValue && seller.SellerRating > 0)
                                            {
                                                <span class="rating-badge">
                                                    <i class="mdi mdi-star"></i> @seller.SellerRating.Value.ToString("N0")
                                                </span>
                                            }
                                            <span class="badge @(seller.IsActive ? "bg-success" : "bg-secondary") font-size-9" style="padding: 1px 5px;">
                                                @(seller.IsActive ? "فعال" : "غیرفعال")
                                            </span>
                                        </div>
                                    </div>
                                    <div class="sr-price">
                                        @if (seller.CurrentPrice > 0)
                                        {
                                            <span class="sr-price-value">@seller.CurrentPrice.ToTomanFormat()</span>
                                            <span class="sr-price-unit"> ت</span>
                                        }
                                        @if (sChange.HasValue && sChange != 0)
                                        {
                                            var sUp = sChange > 0;
                                            <span class="price-change @(sUp ? "up" : "down") ms-2">
                                                @(sUp ? "▲" : "▼") @Math.Abs(sPercent ?? 0).ToString("N1")%
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* ── Price History with Filters ───────────────────────── *@
    @{
        var allHistory = Model.ColorGroups
            .SelectMany(g => g.RecentHistory.Select(h => new { g.ColorName, g.ColorHex, History = h }))
            .OrderByDescending(x => x.History.CreatedDate)
            .Take(100)
            .ToList();

        var uniqueColors = Model.ColorGroups
            .Where(g => g.ColorHex is not null)
            .Select(g => new { g.ColorName, g.ColorHex })
            .ToList();

        var uniqueSellers = allHistory
            .Where(h => h.History.SellerName is not null)
            .Select(h => h.History.SellerName)
            .Distinct()
            .ToList();
    }

    @if (allHistory.Any())
    {
        <div class="pd-card mb-4">
            <div class="section-header">
                <div class="section-title">
                    <i class="mdi mdi-history"></i>
                    تاریخچه تغییرات
                </div>
                <span class="section-count" id="history-count">@allHistory.Count تغییر</span>
            </div>

            @* ── Filter Chips ── *@
            <div class="history-filters">

                @* Color filters *@
                <div class="filter-group">
                    <span class="filter-label">رنگ:</span>
                    <button class="filter-chip active" onclick="filterHistory('color', 'all', this)">
                        همه
                    </button>
                    @foreach (var color in uniqueColors)
                    {
                        <button class="filter-chip" onclick="filterHistory('color', '@color.ColorName', this)">
                            <span class="cd" style="background-color: @color.ColorHex; width:10px; height:10px;"></span>
                            @color.ColorName
                        </button>
                    }
                </div>

                @* Seller filters *@
                @if (uniqueSellers.Count > 1)
                {
                    <div class="filter-group">
                        <span class="filter-label">فروشنده:</span>
                        <button class="filter-chip active" onclick="filterHistory('seller', 'all', this)">
                            همه
                        </button>
                        @foreach (var seller in uniqueSellers)
                        {
                            <button class="filter-chip" onclick="filterHistory('seller', '@seller', this)">
                                @seller
                            </button>
                        }
                    </div>
                }
            </div>

            @* ── History Items ── *@
            <div id="history-container">
                @{
                    int hIdx = 0;
                }
                @foreach (var item in allHistory)
                {
                    hIdx++;
                    var isUp = item.History.NewPrice > item.History.OldPrice;
                    // Determine dot color based on actual price change, neutral if no price change
                    var dotClass = item.History.ChangePercent != 0 ? (isUp ? "up" : "down") : "neutral";

                    <div class="history-item"
                         data-color="@item.ColorName"
                         data-seller="@item.History.SellerName">

                        <span class="hi-dot @dotClass"></span>

                        <div class="hi-body">
                            <div class="hi-header">
                                <div class="d-flex align-items-center gap-2">
                                    @if (item.ColorHex is not null)
                                    {
                                        <span class="cd" style="background-color: @item.ColorHex;"></span>
                                    }
                                    <span class="hi-seller">@item.History.SellerName</span>
                                    <span class="font-size-11 text-muted">@item.ColorName</span>
                                </div>
                                <span class="hi-time">@item.History.CreatedDate.ToPersianRelativeTime()</span>
                            </div>

                            <div class="hi-prices">
                                @* LOGIC FIX START: Check if price actually changed *@
                                @if (item.History.OldPrice == item.History.NewPrice)
                                {
                                    @* Scenario: Price is stable, only BuyBox changed *@
                                    <span class="hi-price-stable">
                                        @item.History.NewPrice.ToTomanFormat()
                                        <span class="font-size-10 text-muted fw-normal">ت</span>
                                    </span>
                                }
                                else
                                {
                                    @* Scenario: Actual price change occurred *@
                                    @if (item.History.OldPrice > 0)
                                    {
                                        <span class="hi-old">@item.History.OldPrice.ToTomanFormat()</span>
                                        <span class="hi-arrow">←</span>
                                    }
                                    <span class="hi-new">
                                        @item.History.NewPrice.ToTomanFormat()
                                        <span class="font-size-10 text-muted fw-normal">ت</span>
                                    </span>

                                    @if (item.History.ChangePercent != 0)
                                    {
                                        <span class="price-change @(isUp ? "up" : "down")">
                                            @(isUp ? "▲" : "▼") @Math.Abs(item.History.ChangePercent).ToString("N1")%
                                        </span>
                                    }
                                }
                                @* LOGIC FIX END *@

                                @if (item.History.BuyBoxChanged)
                                {
                                    @if (item.History.IsBuyBoxWinner)
                                    {
                                        <span class="buybox-badge win" title="این فروشنده بای‌باکس را فتح کرد">
                                            <i class="mdi mdi-trophy font-size-11"></i>
                                            برنده جدید بای‌باکس
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="buybox-badge loss" title="این فروشنده بای‌باکس را از دست داد">
                                            <i class="mdi mdi-close-circle-outline font-size-11"></i>
                                            خروج از بای‌باکس
                                        </span>
                                    }
                                }
                            </div>

                            @* ── Change Description ── *@
                            @if (!string.IsNullOrWhiteSpace(item.History.ChangeDescription))
                            {
                                <div class="hi-description">
                                    <i class="mdi mdi-information-outline"></i>
                                    <span>@item.History.ChangeDescription</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @* ── Empty state when filters hide everything ── *@
            <div id="history-empty" class="text-center text-muted py-4" style="display: none;">
                <i class="mdi mdi-filter-off-outline font-size-20 d-block mb-1"></i>
                تغییری با این فیلتر یافت نشد
            </div>
        </div>
    }
</div>

@section FooterReferences {
    <script src="/js/UserPanel/product-details.js" asp-append-version="true"></script>
}