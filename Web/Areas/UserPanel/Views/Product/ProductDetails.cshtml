@using Application.Dtos.Products.ClientSide
@using Application.Tools
@model ClientSideProductDetailsDto

@{
    ViewData["Title"] = "جزئیات رصد";
}

@section HeaderReferences {
    <link rel="stylesheet" href="/css/UserPanel/product-details.css" type="text/css" asp-append-version="true" />
}

<div class="container-fluid">

    @* ── Breadcrumb ────────────────────────────────────── *@
    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت محصولات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Product" asp-action="ProductsList">لیست محصولات</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    @* ── Product Hero ──────────────────────────────────── *@
    <div class="pd-card product-hero mb-3">
        <div class="p-3 p-md-4">
            <div class="d-flex gap-3 align-items-start">

                <div class="product-image-frame flex-shrink-0">
                    <img src="@Model.ImageUrl" alt="@Model.Title">
                </div>

                <div class="flex-grow-1 min-width-0">

                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <span class="badge bg-dark text-white font-size-10 px-2 py-1 rounded-pill">رصد فعال</span>
                    </div>

                    <h4 class="text-dark fw-bold font-size-14 font-size-md-15 mb-2" style="line-height: 1.7;">
                        @Model.Title
                    </h4>

                    <div class="d-flex flex-wrap align-items-center gap-2 font-size-12 text-muted">
                        @* Show the specific variant being tracked *@
                        @if (!string.IsNullOrEmpty(Model.VariantColorName))
                        {
                            <div class="d-flex align-items-center gap-1">
                                @if (!string.IsNullOrEmpty(Model.VariantColorHex))
                                {
                                    <span class="cd" style="background-color: @Model.VariantColorHex; width: 12px; height: 12px; border-radius: 50%; display: inline-block;"></span>
                                }
                                <span class="fw-bold text-dark">@Model.VariantColorName</span>
                            </div>
                            <span>·</span>
                        }
                        <span>@Model.TotalActiveSellersInVariant فروشنده فعال</span>
                        <span>·</span>
                        <span><i class="mdi mdi-clock-outline font-size-11"></i> @Model.LastUpdatedDate.ToPersianRelativeTime()</span>
                    </div>

                    <div class="mt-2">
                        <a href="@Model.Url" target="_blank" class="btn btn-sm btn-outline-dark rounded-pill px-3 font-size-11">
                            <i class="mdi mdi-open-in-new me-1"></i> مشاهده در دیجی‌کالا
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Stats ─────────────────────────────────────────── *@
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <div class="stat-pill">
            <div class="stat-label">وضعیت شما</div>
            <div class="stat-value">
                @if (Model.TrackedSeller?.IsBuyBoxWinner == true)
                {
                    <span class="text-success"><i class="mdi mdi-trophy"></i> برنده</span>
                }
                else
                {
                    <span class="text-danger"><i class="mdi mdi-trophy-off"></i> شکست</span>
                }
            </div>
        </div>
        <div class="stat-pill">
            <div class="stat-label">قیمت شما</div>
            <div class="stat-value">
                @if (Model.TrackedSeller?.CurrentPrice > 0)
                {
                    @Model.TrackedSeller.CurrentPrice.ToTomanFormat()
                    <span class="stat-unit">ت</span>
                }
                else
                {
                    @:ناموجود
                }
            </div>
        </div>
        <div class="stat-pill">
            <div class="stat-label">تغییرات اخیر</div>
            <div class="stat-value">
                @Model.RecentHistory.Count <span class="stat-unit">مورد</span>
            </div>
        </div>
    </div>

    @* ── Sellers Arena (You vs Winner vs Others) ───────── *@
    <div class="pd-card mb-3">
        <div class="section-header">
            <div class="section-title">
                <i class="mdi mdi-sword-cross"></i>
                میدان رقابت این تنوع
            </div>
        </div>

        <div class="p-2 p-md-3">

            @* 1. The User's Tracked Seller *@
            @if (Model.TrackedSeller != null)
            {
                var s = Model.TrackedSeller;
                <div class="seller-row" style="border: 2px solid #3b82f6; background-color: #eff6ff; border-radius: 8px; margin-bottom: 8px;">
                    <div class="sr-info">
                        <div class="sr-name fw-bold text-dark">
                            <i class="mdi mdi-account-check text-primary font-size-14"></i> @s.SellerName (شما)
                        </div>
                        <div class="sr-meta">
                            @if (s.IsBuyBoxWinner)
                            {
                                <span class="winner-badge"><i class="mdi mdi-trophy font-size-11"></i> برنده بای‌باکس</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger font-size-9">بای‌باکس را از دست داده‌اید</span>
                            }
                        </div>
                    </div>
                    <div class="sr-price">
                        @if (s.CurrentPrice > 0)
                        {
                            <span class="sr-price-value fw-bold">@s.CurrentPrice.ToTomanFormat()</span>
                            <span class="sr-price-unit"> ت</span>
                        }
                        else
                        {
                            <span class="text-danger">ناموجود</span>
                        }
                    </div>
                </div>
            }

            @* 2. The Current Winner (If it's not the user) *@
            @if (Model.WinnerSeller != null && Model.WinnerSeller.Id != Model.TrackedSeller?.Id)
            {
                var w = Model.WinnerSeller;
                <div class="seller-row" style="border: 1px solid #f0f0f0; border-radius: 8px; margin-bottom: 8px;">
                    <div class="sr-info">
                        <div class="sr-name text-success fw-bold">
                            <i class="mdi mdi-crown font-size-14"></i> @w.SellerName
                        </div>
                        <div class="sr-meta">
                            <span class="winner-badge"><i class="mdi mdi-trophy font-size-11"></i> برنده فعلی</span>
                        </div>
                    </div>
                    <div class="sr-price">
                        @if (w.CurrentPrice > 0)
                        {
                            <span class="sr-price-value text-success fw-bold">@w.CurrentPrice.ToTomanFormat()</span>
                            <span class="sr-price-unit"> ت</span>
                        }
                    </div>
                </div>
            }

            @* 3. Other Competitors *@
            @foreach (var seller in Model.Opponents)
            {
                <div class="seller-row" style="border-bottom: 1px solid #f9fafb; padding: 10px 0;">
                    <div class="sr-info">
                        <div class="sr-name text-muted font-size-12">@seller.SellerName</div>
                    </div>
                    <div class="sr-price">
                        @if (seller.CurrentPrice > 0)
                        {
                            <span class="sr-price-value text-muted">@seller.CurrentPrice.ToTomanFormat()</span>
                            <span class="sr-price-unit text-muted"> ت</span>
                        }
                        else
                        {
                            <span class="text-muted font-size-11">ناموجود</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* ── Price History (Strictly for this variant) ────── *@
    @{
        var allHistory = Model.RecentHistory
            .OrderByDescending(h => h.CreatedDate)
            .Take(100)
            .ToList();

        var uniqueSellers = allHistory
            .Where(h => !string.IsNullOrEmpty(h.SellerName))
            .Select(h => h.SellerName)
            .Distinct()
            .ToList();
    }

    @if (allHistory.Any())
    {
        <div class="pd-card mb-4">
            <div class="section-header">
                <div class="section-title">
                    <i class="mdi mdi-history"></i>
                    تاریخچه تغییرات
                </div>
                <span class="section-count" id="history-count">@allHistory.Count تغییر</span>
            </div>

            @* ── Seller Filters (No color filters needed anymore) ── *@
            @if (uniqueSellers.Count > 1)
            {
                <div class="history-filters p-3 border-bottom">
                    <div class="filter-group">
                        <span class="filter-label">فروشنده:</span>
                        <button class="filter-chip active" onclick="filterHistory('all', this)">
                            همه
                        </button>
                        @foreach (var seller in uniqueSellers)
                        {
                            <button class="filter-chip" onclick="filterHistory('@seller', this)">
                                @seller
                            </button>
                        }
                    </div>
                </div>
            }

            @* ── History Items ── *@
            <div id="history-container" class="p-3">
                @foreach (var item in allHistory)
                {
                    var isUp = item.NewPrice > item.OldPrice;
                    var dotClass = item.ChangePercent != 0 ? (isUp ? "up" : "down") : "neutral";
                    var isYou = item.SellerName == Model.TrackedSeller?.SellerName;

                    <div class="history-item" data-seller="@item.SellerName" style="@(isYou ? "background-color: #eff6ff; border-radius: 8px; padding: 8px;" : "")">

                        <span class="hi-dot @dotClass"></span>

                        <div class="hi-body">
                            <div class="hi-header">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="hi-seller @(isYou ? "fw-bold text-primary" : "")">@item.SellerName</span>
                                    @if (isYou)
                                    {
                                        <span class="badge bg-primary font-size-9">شما</span>
                                    }
                                </div>
                                <span class="hi-time">@item.CreatedDate.ToPersianRelativeTime()</span>
                            </div>

                            <div class="hi-prices">
                                @if (item.OldPrice == item.NewPrice)
                                {
                                    <span class="hi-price-stable">
                                        @item.NewPrice.ToTomanFormat()
                                        <span class="font-size-10 text-muted fw-normal">ت</span>
                                    </span>
                                }
                                else
                                {
                                    @if (item.OldPrice > 0)
                                    {
                                        <span class="hi-old">@item.OldPrice.ToTomanFormat()</span>
                                        <span class="hi-arrow">←</span>
                                    }
                                    <span class="hi-new">
                                        @item.NewPrice.ToTomanFormat()
                                        <span class="font-size-10 text-muted fw-normal">ت</span>
                                    </span>

                                    @if (item.ChangePercent.HasValue)
                                    {
                                        <span class="price-change @(isUp ? "up" : "down")">
                                            @(isUp ? "▲" : "▼") @Math.Abs(item.ChangePercent.Value).ToString("N1")%
                                        </span>
                                    }
                                }

                                @if (item.BuyBoxChanged)
                                {
                                    @if (item.IsBuyBoxWinner)
                                    {
                                        <span class="buybox-badge win" title="این فروشنده بای‌باکس را فتح کرد">
                                            <i class="mdi mdi-trophy font-size-11"></i>
                                            فتح بای‌باکس
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="buybox-badge loss" title="این فروشنده بای‌باکس را از دست داد">
                                            <i class="mdi mdi-close-circle-outline font-size-11"></i>
                                            خروج از بای‌باکس
                                        </span>
                                    }
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.ChangeDescription))
                            {
                                <div class="hi-description">
                                    <i class="mdi mdi-information-outline"></i>
                                    <span>@item.ChangeDescription</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @* ── Empty state when filters hide everything ── *@
            <div id="history-empty" class="text-center text-muted py-4" style="display: none;">
                <i class="mdi mdi-filter-off-outline font-size-20 d-block mb-1"></i>
                تغییری با این فیلتر یافت نشد
            </div>
        </div>
    }
</div>

@section FooterReferences {
    <script src="/js/UserPanel/product-details.js" asp-append-version="true"></script>
}