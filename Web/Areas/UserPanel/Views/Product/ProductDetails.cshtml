@using Application.Dtos.Products.ClientSide
@using Application.Tools
@model ClientSideProductDetailsDto

@{
    ViewData["Title"] = "جزئیات و تاریخچه قیمت محصول";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت محصولات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>

                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Product" asp-action="ProductsList">لیست محصولات</a>
                    </li>

                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-body p-4">
                    <div class="row g-4 align-items-center">
                        <div class="col-12 col-md-3 text-center">
                            <div class="bg-light p-3 rounded-3 d-inline-block" style="width: 100%; max-width: 200px; height: 200px;">
                                <img src="@Model.ImageUrl" class="img-fluid h-100 object-fit-contain rounded-2" alt="نام کالا">
                            </div>
                        </div>
                        <div class="col-12 col-md-9">
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <span class="badge bg-soft-success text-success px-2 py-1 font-size-11 rounded">در حال مانیتور آنلاین</span>
                                <span class="badge bg-soft-primary text-primary px-2 py-1 font-size-11 rounded">منبع: دیجی‌کالا</span>
                                <span class="badge bg-light text-muted px-2 py-1 font-size-11 rounded">شناسه: dkp-@Model.DigiKalaId</span>
                            </div>

                            <h4 class="text-dark fw-bold font-size-16 mb-3" style="line-height: 1.6;">
                                @Model.Title
                            </h4>

                            <div class="row g-3 mt-2 pt-3 border-top border-light">
                                <div class="col-6 col-sm-4">
                                    <span class="text-muted font-size-12 d-block mb-1">قیمت فعلی بازار:</span>
                                    <h5 class="text-primary fw-extrabold font-size-18 mb-0">
                                        @Model.NewPrice.ToTomanFormat() <span class="font-size-11 text-muted fw-normal">تومان</span>
                                    </h5>
                                </div>
                                <div class="col-6 col-sm-4">
                                    <span class="text-muted font-size-12 d-block mb-1">آخرین تغییر قیمت:</span>
                                    <h5 class="text-dark fw-bold font-size-14 mb-0 mt-1">
                                        <i class="mdi mdi-clock-check-outline text-success me-1"></i> @Model.LastUpdatedDate.ToPersianRelativeTime()
                                    </h5>
                                </div>
                                <div class="col-12 col-sm-4 text-sm-end">
                                    <a href="@Model.Url" target="_blank" class="btn btn-danger btn-md px-3 mt-2 rounded-2 font-size-13">
                                        <i class="mdi mdi-open-in-new me-1"></i> مشاهده صفحه اصلی کالا
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 col-sm-6 col-md-4">
            <div class="card bg-soft-success border-0 rounded-3 shadow-sm mb-3">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted font-size-12 d-block mb-1">کمترین قیمت ثبت شده</span>
                        <h5 class="text-success fw-bold font-size-15 mb-0">@Model.AllTimeMinPrice?.ToToman()</h5>
                    </div>
                    <div class="avatar-sm bg-success text-white rounded-circle d-flex align-items-center justify-content-center">
                        <i class="mdi mdi-arrow-down-bold font-size-20"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4">
            <div class="card bg-soft-danger border-0 rounded-3 shadow-sm mb-3">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted font-size-12 d-block mb-1">بیشترین قیمت ثبت شده</span>
                        <h5 class="text-danger fw-bold font-size-15 mb-0">@Model.AllTimeMaxPrice?.ToToman()</h5>
                    </div>
                    <div class="avatar-sm bg-danger text-white rounded-circle d-flex align-items-center justify-content-center">
                        <i class="mdi mdi-arrow-up-bold font-size-20"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card bg-soft-info border-0 rounded-3 shadow-sm mb-3">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted font-size-12 d-block mb-1">تعداد کل نوسانات امروز</span>
                        <h5 class="text-info fw-bold font-size-15 mb-0">
                            @Model.TodayPriceChangesCount
                            مرتبه تغییر قیمت
                        </h5>
                    </div>
                    <div class="avatar-sm bg-info text-white rounded-circle d-flex align-items-center justify-content-center">
                        <i class="mdi mdi-history font-size-20"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom border-light py-3">
                    <h5 class="font-size-14 text-dark fw-bold mb-0">
                        <i class="mdi mdi-format-list-bulleted text-primary me-1"></i> لیست لاگ‌های قیمتی استخراج شده
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-centered align-middle mb-0 text-nowrap">
                            <thead class="table-light font-size-13 text-muted">
                                <tr>
                                    <th class="ps-4">ردیف</th>
                                    <th>قیمت ثبت شده</th>
                                    <th class="pe-4">تاریخ و ساعت ثبت لاگ</th>
                                </tr>
                            </thead>
                            <tbody class="font-size-13 text-dark">
                                @{
                                    int counter = 0;
                                    foreach (var item in Model.History ?? new List<ClientSideProductPriceHistoryDto>())
                                    {
                                        counter++;
                                        <tr>
                                            <td class="ps-4 fw-bold text-muted">@counter</td>
                                            <td class="fw-bold">@item.Price.ToToman()</td>
                                            <td class="pe-4 text-muted">@item.CreatedDate.GetDateTime()</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>