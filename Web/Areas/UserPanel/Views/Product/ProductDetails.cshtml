@using Application.Dtos.Products.ClientSide
@using Application.Tools
@model ClientSideProductDetailsDto

@{
    ViewData["Title"] = "جزئیات و تاریخچه قیمت محصول";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت محصولات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Product" asp-action="ProductsList">لیست محصولات</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border border-dark rounded-3 overflow-hidden shadow-sm" style="border-radius: 4px !important; background: #ffffff;">
                <div class="card-body p-4">
                    <div class="row g-4 align-items-center">

                        <div class="col-12 col-md-3 text-center">
                            <div class="bg-light p-3 border rounded-3 d-inline-block" style="width: 100%; max-width: 200px; height: 200px; border-color: #dee2e6 !important;">
                                <img src="@Model.ImageUrl" class="img-fluid h-100 object-fit-contain rounded-2" alt="@Model.Title">
                            </div>
                        </div>

                        <div class="col-12 col-md-9">
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <span class="badge bg-dark text-white px-2 py-1 font-size-11 rounded">
                                    در حال مانیتور آنلاین
                                </span>
                                <span class="badge bg-light text-dark border px-2 py-1 font-size-11 rounded">
                                    منبع: دیجی‌کالا
                                </span>
                                <span class="badge bg-light text-muted border px-2 py-1 font-size-11 rounded">
                                    شناسه: dkp-@Model.DigiKalaId
                                </span>
                                <span class="badge bg-light text-muted border px-2 py-1 font-size-11 rounded">
                                    @Model.TotalVariantsCount تنوع · @Model.TotalSellersCount فروشنده
                                </span>
                            </div>

                            <h4 class="text-dark fw-bold font-size-15 mb-3" style="line-height: 1.6;">
                                @Model.Title
                            </h4>

                            @if (Model.BuyBoxSellerName is not null)
                            {
                                <div class="row g-3 mt-2 pt-3 border-top border-light-subtle">
                                    <div class="col-6 col-sm-3">
                                        <span class="text-muted font-size-12 d-block mb-1">
                                            <i class="mdi mdi-trophy text-warning"></i> برنده بای‌باکس:
                                        </span>
                                        <h5 class="text-dark fw-extrabold font-size-14 mb-0">
                                            @Model.BuyBoxSellerName
                                        </h5>
                                    </div>

                                    <div class="col-6 col-sm-3">
                                        <span class="text-muted font-size-12 d-block mb-1">قیمت بای‌باکس:</span>
                                        <h5 class="text-dark fw-extrabold font-size-17 mb-0">
                                            @if (Model.BuyBoxPrice.HasValue && Model.BuyBoxPrice > 0)
                                            {
                                                @Model.BuyBoxPrice.Value.ToTomanFormat()
                                                <span class="font-size-10 text-muted fw-normal">تومان</span>
                                            }
                                            else
                                            {
                                                @:ناموجود
                                            }
                                        </h5>
                                    </div>

                                    <div class="col-6 col-sm-3">
                                        <span class="text-muted font-size-12 d-block mb-1">رنگ بای‌باکس:</span>
                                        <h5 class="text-dark fw-bold font-size-13 mb-0">
                                            @Model.BuyBoxColorName
                                        </h5>
                                    </div>

                                    <div class="col-6 col-sm-3 text-sm-end d-flex align-items-end justify-content-sm-end">
                                        <a href="@Model.Url" target="_blank"
                                           class="btn btn-outline-dark btn-sm px-3 mt-2 rounded-2 font-size-12 w-100 w-sm-auto">
                                            <i class="mdi mdi-open-in-new me-1"></i> مشاهده منبع
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border border-dark rounded-3 shadow-sm mb-2" style="background: #ffffff; border-radius: 4px !important; border-right: 4px solid #000000 !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted font-size-11 d-block mb-1">کمترین قیمت فعلی</span>
                        <h5 class="text-dark fw-bold font-size-14 mb-0">
                            @if (Model.LowestCurrentPrice > 0)
                            {
                                @Model.LowestCurrentPrice.ToTomanFormat()
                            }
                            else
                            {
                                @:ناموجود
                            }
                        </h5>
                    </div>
                    <div class="avatar-sm bg-light text-dark border border-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="mdi mdi-arrow-down-bold font-size-16"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border border-dark rounded-3 shadow-sm mb-2" style="background: #ffffff; border-radius: 4px !important; border-right: 4px solid #000000 !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted font-size-11 d-block mb-1">بیشترین قیمت فعلی</span>
                        <h5 class="text-dark fw-bold font-size-14 mb-0">
                            @if (Model.HighestCurrentPrice > 0)
                            {
                                @Model.HighestCurrentPrice.ToTomanFormat()
                            }
                            else
                            {
                                @:ناموجود
                            }
                        </h5>
                    </div>
                    <div class="avatar-sm bg-light text-dark border border-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="mdi mdi-arrow-up-bold font-size-16"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border border-dark rounded-3 shadow-sm mb-2" style="background: #ffffff; border-radius: 4px !important; border-right: 4px solid #000000 !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted font-size-11 d-block mb-1">تعداد تنوع فعال</span>
                        <h5 class="text-dark fw-bold font-size-14 mb-0">
                            @Model.TotalVariantsCount تنوع
                        </h5>
                    </div>
                    <div class="avatar-sm bg-light text-dark border border-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="mdi mdi-palette-outline font-size-16"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border border-dark rounded-3 shadow-sm mb-2" style="background: #ffffff; border-radius: 4px !important; border-right: 4px solid #000000 !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted font-size-11 d-block mb-1">تعداد فروشنده فعال</span>
                        <h5 class="text-dark fw-bold font-size-14 mb-0">
                            @Model.TotalSellersCount فروشنده
                        </h5>
                    </div>
                    <div class="avatar-sm bg-light text-dark border border-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="mdi mdi-store font-size-16"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border border-dark rounded-3 shadow-sm" style="border-radius: 4px !important;">
                <div class="card-header bg-light border-bottom border-dark py-2.5">
                    <h5 class="font-size-13 text-dark fw-bold mb-0">
                        <i class="mdi mdi-format-list-bulleted text-dark me-1"></i>
                        لیست تنوع‌ها و فروشندگان
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-centered mb-0 font-size-13">
                            <thead class="table-light text-dark">
                                <tr>
                                    <th style="width: 50px;" class="text-center">#</th>
                                    <th>رنگ</th>
                                    <th>فروشنده</th>
                                    <th>امتیاز</th>
                                    <th>قیمت فعلی</th>
                                    <th>تغییر قیمت</th>
                                    <th class="text-center">بای‌باکس</th>
                                    <th class="text-center">وضعیت</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNum = 0;
                                }
                                @foreach (var variant in Model.Variants)
                                {
                                    rowNum++;
                                    var seller = variant.Seller;
                                    var priceChange = seller.PriceChange;
                                    var changePercent = seller.PriceChangePercent;

                                    <tr class="@(seller.IsBuyBoxWinner ? "table-warning" : "")">
                                        <td class="text-center text-muted">@rowNum</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (variant.ColorHex is not null)
                                                {
                                                    <span class="d-inline-block rounded-circle border"
                                                          style="width: 16px; height: 16px; background-color: @variant.ColorHex;">
                                                    </span>
                                                }
                                                <span>@variant.ColorName</span>
                                            </div>
                                        </td>
                                        <td class="fw-semibold">@seller.SellerName</td>
                                        <td>
                                            @if (seller.SellerRating.HasValue)
                                            {
                                                <span class="badge bg-light text-dark border font-size-11">
                                                    <i class="mdi mdi-star text-warning"></i>
                                                    @seller.SellerRating.Value
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="fw-bold">
                                            @if (seller.CurrentPrice > 0)
                                            {
                                                @seller.CurrentPrice.ToTomanFormat()
                                                <span class="font-size-10 text-muted fw-normal">تومان</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">ناموجود</span>
                                            }
                                        </td>
                                        <td>
                                            @if (priceChange.HasValue && priceChange != 0)
                                            {
                                                var isUp = priceChange > 0;
                                                <span class="badge @(isUp ? "bg-danger" : "bg-success") font-size-11" style="direction: ltr;">
                                                    @(isUp ? "+" : "")@changePercent%
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted font-size-11">بدون تغییر</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (seller.IsBuyBoxWinner)
                                            {
                                                <span class="badge bg-warning text-dark font-size-11">
                                                    <i class="mdi mdi-trophy"></i> برنده
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (seller.IsActive)
                                            {
                                                <span class="badge bg-success font-size-10">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary font-size-10">غیرفعال</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Variants.Any(v => v.Seller.RecentHistory.Count > 1))
    {
        <div class="row">
            <div class="col-12">
                <div class="card border border-dark rounded-3 shadow-sm" style="border-radius: 4px !important;">
                    <div class="card-header bg-light border-bottom border-dark py-2.5">
                        <h5 class="font-size-13 text-dark fw-bold mb-0">
                            <i class="mdi mdi-history text-dark me-1"></i>
                            آخرین تغییرات قیمت
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-centered mb-0 font-size-13">
                                <thead class="table-light text-dark">
                                    <tr>
                                        <th style="width: 50px;" class="text-center">#</th>
                                        <th>رنگ</th>
                                        <th>فروشنده</th>
                                        <th>قیمت قبلی</th>
                                        <th>قیمت جدید</th>
                                        <th>درصد تغییر</th>
                                        <th class="text-center">تغییر بای‌باکس</th>
                                        <th>تاریخ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int historyRow = 0;
                                    }
                                    @foreach (var variant in Model.Variants)
                                    {
                                        foreach (var history in variant.Seller.RecentHistory
                                            .Where(h => h.OldPrice != h.NewPrice || h.BuyBoxChanged))
                                        {
                                            historyRow++;
                                            var isUp = history.NewPrice > history.OldPrice;

                                            <tr>
                                                <td class="text-center text-muted">@historyRow</td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (variant.ColorHex is not null)
                                                        {
                                                            <span class="d-inline-block rounded-circle border"
                                                                  style="width: 14px; height: 14px; background-color: @variant.ColorHex;">
                                                            </span>
                                                        }
                                                        <span class="font-size-12">@variant.ColorName</span>
                                                    </div>
                                                </td>
                                                <td class="font-size-12">@variant.Seller.SellerName</td>
                                                <td class="text-muted">
                                                    @if (history.OldPrice > 0)
                                                    {
                                                        <span class="text-decoration-line-through">
                                                            @history.OldPrice.ToTomanFormat()
                                                        </span>
                                                    }
                                                </td>
                                                <td class="fw-bold">
                                                    @history.NewPrice.ToTomanFormat()
                                                    <span class="font-size-10 text-muted fw-normal">تومان</span>
                                                </td>
                                                <td>
                                                    @if (history.ChangePercent != 0)
                                                    {
                                                        <span class="badge @(isUp ? "bg-danger" : "bg-success") font-size-11" style="direction: ltr;">
                                                            @(isUp ? "+" : "")@history.ChangePercent%
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (history.BuyBoxChanged)
                                                    {
                                                        <span class="badge bg-info text-dark font-size-10">
                                                            <i class="mdi mdi-swap-horizontal"></i> تغییر کرد
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-muted font-size-12">
                                                    @history.CreatedDate.GetDateTime()
                                                </td>
                                            </tr>
                                        }
                                    }

                                    @if (historyRow == 0)
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-4">
                                                <i class="mdi mdi-information-outline font-size-16 d-block mb-1"></i>
                                                هنوز تغییر قیمتی ثبت نشده است
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>