@using Application.Dtos.Products.ClientSide
@using Application.Tools
@model ClientSideProductDetailsDto

@{
    ViewData["Title"] = "جزئیات و تاریخچه قیمت محصول";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت محصولات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Product" asp-action="ProductsList">لیست محصولات</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border border-dark rounded-3 overflow-hidden shadow-sm" style="border-radius: 4px !important; background: #ffffff;">
                <div class="card-body p-4">
                    <div class="row g-4 align-items-center">

                        <div class="col-12 col-md-3 text-center">
                            <div class="bg-light p-3 border rounded-3 d-inline-block" style="width: 100%; max-width: 200px; height: 200px; border-color: #dee2e6 !important;">
                                <img src="@Model.ImageUrl" class="img-fluid h-100 object-fit-contain rounded-2" alt="@Model.Title">
                            </div>
                        </div>

                        <div class="col-12 col-md-9">
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <span class="badge bg-dark text-white px-2 py-1 font-size-11 rounded">در حال مانیتور آنلاین</span>
                                <span class="badge bg-light text-dark border px-2 py-1 font-size-11 rounded">منبع: دیجی‌کالا</span>
                                <span class="badge bg-light text-muted border px-2 py-1 font-size-11 rounded">شناسه: dkp-@Model.DigiKalaId</span>
                            </div>

                            <h4 class="text-dark fw-bold font-size-15 mb-3" style="line-height: 1.6;">
                                @Model.Title
                            </h4>

                            <div class="row g-3 mt-2 pt-3 border-top border-light-subtle">

                                <div class="col-6 col-sm-3">
                                    <span class="text-muted font-size-12 d-block mb-1">قیمت فعلی بازار:</span>
                                    <h5 class="text-dark fw-extrabold font-size-17 mb-0 d-flex align-items-center gap-2">
                                        @if (Model.NewPrice > 0)
                                        {
                                            @Model.NewPrice.ToTomanFormat()
                                            <span class="font-size-10 text-muted fw-normal">تومان</span>
                                        }
                                        else
                                        {
                                            @: ناموجود
                                        }

                                        @if (Model.ChangePercent.HasValue && Model.ChangePercent.Value != 0)
                                        {
                                            var isDrop = Model.ChangePercent.Value < 0;
                                            <span class="badge bg-danger font-size-11 px-1.5 py-0.5 rounded" style="direction: ltr;">
                                                @(isDrop ? "" : "+")@Model.ChangePercent.Value%
                                            </span>
                                        }
                                    </h5>
                                </div>

                                <div class="col-6 col-sm-3">
                                    <span class="text-muted font-size-12 d-block mb-1">قیمت قبلی بازار:</span>
                                    <h5 class="mb-0">
                                        @if (Model.OldPrice > 0)
                                        {
                                            <span class="text-danger text-decoration-line-through font-size-15 fw-semibold opacity-75">
                                                @Model.OldPrice.ToTomanFormat()
                                                <span class="font-size-10 text-muted fw-normal d-inline-block text-decoration-none">تومان</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted font-size-14 fw-normal">ناموجود</span>
                                        }
                                    </h5>
                                </div>

                                <div class="col-6 col-sm-3">
                                    <span class="text-muted font-size-12 d-block mb-1">آخرین تغییر قیمت:</span>
                                    <h5 class="text-dark fw-bold font-size-13 mb-0 mt-1">
                                        <i class="mdi mdi-clock-check-outline text-muted me-1"></i> @Model.LastUpdatedDate.ToPersianRelativeTime()
                                    </h5>
                                </div>

                                <div class="col-6 col-sm-3 text-sm-end d-flex align-items-end justify-content-sm-end">
                                    <a href="@Model.Url" target="_blank" class="btn btn-outline-dark btn-sm px-3 mt-2 rounded-2 font-size-12 w-100 w-sm-auto">
                                        <i class="mdi mdi-open-in-new me-1"></i> مشاهده منبع
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">

        <div class="col-12 col-sm-6 col-md-4">
            <div class="card border border-dark rounded-3 shadow-sm mb-2" style="background: #ffffff; border-radius: 4px !important; border-right: 4px solid #000000 !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted font-size-11 d-block mb-1">کمترین قیمت ثبت شده</span>
                        <h5 class="text-dark fw-bold font-size-14 mb-0">
                            @if (Model.AllTimeMinPrice > 0)
                            {
                                @Model.AllTimeMinPrice?.ToToman()
                            }
                            else
                            {
                                @: ناموجود
                            }
                        </h5>
                    </div>
                    <div class="avatar-sm bg-light text-dark border border-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="mdi mdi-arrow-down-bold font-size-16"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-4">
            <div class="card border border-dark rounded-3 shadow-sm mb-2" style="background: #ffffff; border-radius: 4px !important; border-right: 4px solid #000000 !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted font-size-11 d-block mb-1">بیشترین قیمت ثبت شده</span>
                        <h5 class="text-dark fw-bold font-size-14 mb-0">
                            @if (Model.AllTimeMaxPrice > 0)
                            {
                                @Model.AllTimeMaxPrice?.ToToman()
                            }
                            else
                            {
                                @: ناموجود
                            }
                        </h5>
                    </div>
                    <div class="avatar-sm bg-light text-dark border border-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="mdi mdi-arrow-up-bold font-size-16"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border border-dark rounded-3 shadow-sm mb-2" style="background: #ffffff; border-radius: 4px !important; border-right: 4px solid #000000 !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted font-size-11 d-block mb-1">نوسانات قیمت امروز</span>
                        <h5 class="text-dark fw-bold font-size-14 mb-0">
                            @Model.TodayPriceChangesCount مرتبه تغییر
                        </h5>
                    </div>
                    <div class="avatar-sm bg-light text-dark border border-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="mdi mdi-history font-size-16"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border border-dark rounded-3 shadow-sm" style="border-radius: 4px !important;">
                <div class="card-header bg-light border-bottom border-dark py-2.5">
                    <h5 class="font-size-13 text-dark fw-bold mb-0">
                        <i class="mdi mdi-format-list-bulleted text-dark me-1"></i> لیست لاگ‌های قیمتی استخراج شده
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-centered mb-0 font-size-13">
                            <thead class="table-light text-dark">
                                <tr>
                                    <th style="width: 60px;" class="text-center">#</th>
                                    <th>قیمت ثبت شده کالا</th>
                                    <th>تاریخ و ساعت دقیق ثبت لاگ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int counter = 0;
                                    foreach (var item in Model.History ?? new List<ClientSideProductPriceHistoryDto>())
                                    {
                                        counter++;
                                        <tr>
                                            <td class="text-center text-muted">@counter</td>
                                            <td class="fw-bold text-dark">
                                                @if (item.Price > 0)
                                                {
                                                    @item.Price.ToToman()
                                                }
                                                else
                                                {
                                                    @: ناموجود
                                                }
                                            </td>
                                            <td class="text-muted">@item.CreatedDate.GetDateTime()</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>