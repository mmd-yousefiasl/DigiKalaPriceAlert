@using Application.Dtos.Products.ClientSide
@using Application.Tools
@using Domain.Enums.Products
@model ClientSideFilterProductsDto

@{
    ViewData["Title"] = "لیست محصولات";
}

@section HeaderReferences {
    <link rel="stylesheet" href="/css/UserPanel/products-list.css" type="text/css" asp-append-version="true" />
}

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت محصولات</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="filter-card mb-3">
        <div class="p-3">
            <form novalidate asp-area="UserPanel" asp-controller="Product" method="get" asp-action="ProductsList" id="search-form">
                <input type="hidden" asp-for="Page" id="Page" />
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-5">
                        <label class="form-label font-size-11 fw-bold text-muted mb-1" asp-for="Search"></label>
                        <input type="text"
                               class="form-control form-control-sm border-light font-size-12"
                               asp-for="Search"
                               autocomplete="off"
                               placeholder="جستجو در عنوان محصولات..."
                               style="border-radius: 8px; background: #f9fafb;">
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label font-size-11 fw-bold text-muted mb-1" asp-for="SortType"></label>
                        <select class="form-control form-control-sm form-select border-light font-size-12"
                                asp-for="SortType"
                                asp-items="@Html.GetEnumSelectList<ProductSortTypeEnum>()"
                                style="border-radius: 8px; background: #f9fafb;">
                        </select>
                    </div>
                    <div class="col-6 col-md-1">
                        <button class="btn btn-dark btn-sm w-100 font-size-11" type="submit" style="border-radius: 8px; height: 33px;">
                            <i class="mdi mdi-magnify"></i>
                        </button>
                    </div>
                    <div class="col-6 col-md-2">
                        <a asp-area="UserPanel" asp-controller="Product" asp-action="AddNewProduct"
                           class="btn btn-outline-dark btn-sm w-100 font-size-11" style="border-radius: 8px; height: 33px; line-height: 21px;">
                            <i class="mdi mdi-plus me-1"></i> افزودن
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model?.Entities?.Any() ?? false)
    {
        <div class="summary-bar">
            <span>
                <strong class="text-dark">@Model.Entities.Count</strong> رصد در این صفحه
            </span>
            @{
                var unreadCount = Model.Entities.Count(e => !e.IsRead);
            }
            @if (unreadCount > 0)
            {
                <span class="meta-tag alert">
                    <i class="mdi mdi-bell-ring-outline font-size-11"></i>
                    @unreadCount تغییر جدید
                </span>
            }
        </div>

        <div class="row g-2">
            @foreach (var item in Model.Entities)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="product-card @(!item.IsRead ? "unread" : "")">

                        @if (!item.IsRead)
                        {
                            <span class="unread-dot" title="تغییر قیمت جدید"></span>
                        }

                        @* Delete Form uses Mapping Id (item.Id) *@
                        <form class="delete-product-form" asp-area="UserPanel" asp-controller="Product" asp-action="DeleteProduct" asp-route-id="@item.Id" onclick="ConfirmDelete(this)" title="حذف از لیست رصد">
                            <div class="delete-btn"><i class="mdi mdi-close font-size-12"></i></div>
                        </form>

                        @* Details link uses Product Id (item.ProductId) *@
                        <a asp-area="UserPanel" asp-controller="Product" asp-action="ProductDetails" asp-route-id="@item.Id" class="text-decoration-none d-block">
                            <div class="p-3 product-card-body">
                                <div class="d-flex gap-3">
                                    <div class="product-thumb">
                                        <img src="@item.ImageUrl" alt="@item.Title">
                                    </div>
                                    <div class="flex-grow-1" style="min-width: 0;">
                                        <h5 class="font-size-13 text-dark fw-bold mb-2 text-truncate" title="@item.Title" style="line-height: 1.5;">
                                            @item.Title
                                        </h5>

                                        <div class="d-flex align-items-center gap-1 flex-wrap mb-2">
                                            @if (item.IsWinningBuyBox)
                                            {
                                                <span class="meta-tag active bg-success-subtle text-success">
                                                    <i class="mdi mdi-trophy font-size-9"></i>
                                                    برنده بای‌باکس
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="meta-tag bg-danger-subtle text-danger">
                                                    <i class="mdi mdi-trophy-off font-size-9"></i>
                                                    باخته‌اید
                                                </span>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(item.VariantColorName))
                                            {
                                                <span class="meta-tag bg-light text-muted font-size-10">
                                                    <i class="mdi mdi-palette-outline font-size-9"></i>
                                                    @item.VariantColorName
                                                </span>
                                            }
                                        </div>

                                        @* SELLER & PRICE DASHBOARD *@
                                        <div class="d-flex justify-content-between align-items-end mt-2 border-top pt-2">
                                            <div style="min-width: 0;">
                                                <small class="font-size-10 text-muted d-block text-truncate" title="@item.SellerName">
                                                    <i class="mdi mdi-store-outline font-size-10"></i> @item.SellerName
                                                </small>
                                                <small class="font-size-10 text-muted d-block mt-1">قیمت شما</small>
                                                @if (item.YourPrice > 0)
                                                {
                                                    <span class="price-main font-size-14 fw-bold text-dark">@item.YourPrice.ToTomanFormat()</span>
                                                    <span class="price-unit font-size-10">ت</span>
                                                }
                                                else
                                                {
                                                    <span class="price-main text-danger font-size-12">ناموجود</span>
                                                }
                                            </div>

                                            @if (item.IsUndercut && item.CompetitorLowestPrice > 0)
                                            {
                                                <div class="text-end">
                                                    <small class="font-size-10 text-danger d-block">
                                                        <i class="mdi mdi-alert-outline"></i> رقیب ارزان‌تر!
                                                    </small>
                                                    <span class="price-main text-danger font-size-13 fw-bold">@item.CompetitorLowestPrice.ToTomanFormat()</span>
                                                    <span class="price-unit text-danger font-size-10">ت</span>
                                                </div>
                                            }
                                            else if (item.CompetitorLowestPrice > 0)
                                            {
                                                <div class="text-end">
                                                    <small class="font-size-10 text-muted d-block">ارزان‌ترین رقیب</small>
                                                    <span class="price-main text-muted font-size-12">@item.CompetitorLowestPrice.ToTomanFormat()</span>
                                                    <span class="price-unit text-muted font-size-10">ت</span>
                                                </div>
                                            }
                                            else
                                            {
                                                // No competitor price found (CompetitorLowestPrice == 0)
                                                if (item.IsWinningBuyBox)
                                                {
                                                    <div class="text-end">
                                                        <small class="font-size-10 text-success d-block">
                                                            <i class="mdi mdi-shield-check-outline"></i> انحصار فروش
                                                        </small>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-end">
                                                        <small class="font-size-10 text-warning d-block">
                                                            <i class="mdi mdi-pause-circle-outline"></i> بدون رقیب فعال
                                                        </small>
                                                        <span class="font-size-10 text-muted">نیاز به بررسی</span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>

                        <a href="@item.Url" target="_blank" class="card-footer-link">
                            <i class="mdi mdi-open-in-new font-size-13"></i>
                            <span>مشاهده در دیجی‌کالا</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="mdi mdi-package-variant-closed d-block mb-3"></i>
            <h5 class="text-dark fw-bold font-size-15 mb-2">محصولی یافت نشد</h5>
            <p class="text-muted font-size-12 mb-3">هنوز محصولی برای رصد اضافه نکرده‌اید یا فیلتر شما نتیجه‌ای ندارد.</p>
            <a asp-area="UserPanel" asp-controller="Product" asp-action="AddNewProduct"
               class="btn btn-dark btn-sm px-4 font-size-12" style="border-radius: 8px;">
                <i class="mdi mdi-plus me-1 fs-small"></i> افزودن محصول جدید
            </a>
        </div>
    }

    <div class="my-3">
        <partial name="_Paging" model="@Model.GetCurrentPaging()" />
    </div>
</div>