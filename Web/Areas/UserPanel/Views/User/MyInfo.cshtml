@using Application.Dtos.Users.ClientSide
@model ClientSideUpdateProfileDto

@{
    ViewData["Title"] = "ویرایش حساب کاربری";
}

<div class="dp-myinfo">
    <div class="container-fluid">

        <div class="row">
            <div class="col-sm-6">
                <div class="page-title-box">
                    <h4>پنل کاربری</h4>
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item">
                            <a asp-area="UserPanel" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                        </li>
                        <li class="breadcrumb-item active">@ViewData["Title"]</li>
                    </ol>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Main Form Column -->
            <div class="col-12 col-lg-9">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            <i class="mdi mdi-account-edit-outline me-1 text-muted"></i> مشخصات فردی شما
                        </h5>
                        <hr class="card-divider" />

                        <form asp-area="UserPanel" asp-controller="User" asp-action="MyInfo" autocomplete="off" method="post">
                            <div class="row g-3">

                                <!-- First Name Field -->
                                <div class="col-12 col-md-6">
                                    <label asp-for="FirstName" class="form-label"></label>
                                    <input class="form-control" type="text" asp-for="FirstName" autocomplete="off" placeholder="نام خود را وارد کنید...">
                                    <span asp-validation-for="FirstName" class="text-danger mt-1 d-block"></span>
                                </div>

                                <!-- Last Name Field -->
                                <div class="col-12 col-md-6">
                                    <label asp-for="LastName" class="form-label"></label>
                                    <input class="form-control" type="text" asp-for="LastName" autocomplete="off" placeholder="نام خانوادگی خود را وارد کنید...">
                                    <span asp-validation-for="LastName" class="text-danger mt-1 d-block"></span>
                                </div>

                                <!-- Submit Button -->
                                <div class="col-12 text-start mt-4">
                                    <button class="btn btn-dark px-4 btn-submit" type="submit">
                                        تایید و ویرایش حساب
                                    </button>
                                </div>

                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Telegram Management Column -->
            <div class="col-12 col-lg-3 d-lg-block">
                <div class="card bg-light shadow-sm">
                    <div class="card-body">

                        <h6 class="fw-bold mb-1">
                            <i class="mdi mdi-telegram me-1"></i>
                            مدیریت بله
                        </h6>

                        <p class="lh-base mb-3">
                            حساب بله متصل خود را مدیریت کنید، در صورت نیاز
                            مجدداً متصل شوید یا اتصال فعلی را آزمایش کنید.
                        </p>

                        <!-- Reconnect -->
                        <div class="d-flex align-items-center justify-content-between mb-3">

                            <div>
                                <h6 class="fw-bold mb-1">
                                    اتصال مجدد
                                </h6>

                                <small>
                                    تغییر یا اتصال مجدد حساب بله
                                </small>
                            </div>

                            <form asp-area="UserPanel"
                                  asp-controller="User"
                                  asp-action="ConnectBale"
                                  method="post"
                                  target="_blank"
                                  class="d-inline-block">

                                <button type="submit"
                                        class="btn btn-dark btn-sm px-3">

                                    <i class="mdi mdi-telegram me-1"></i>
                                    اتصال
                                </button>

                            </form>

                        </div>

                        <hr class="card-divider my-3" />

                        <!-- Test Message -->
                        <div class="d-flex align-items-center justify-content-between">

                            <div>
                                <h6 class="fw-bold mb-1">
                                    تست اتصال
                                </h6>

                                <small>
                                    ارسال یک پیام آزمایشی به بله
                                </small>
                            </div>

                            <form asp-area="UserPanel"
                                  asp-controller="User"
                                  asp-action="SendBaleTestMessageFromMyInfo"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-outline-success btn-sm px-3">

                                    <i class="mdi mdi-bell-check-outline me-1"></i>
                                    تست
                                </button>

                            </form>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>