@{
    ViewData["Title"] = "تکمیل حساب کاربری";
}

<div class="dp-complete-profile">
    <div class="container-fluid">

        <!-- Page Header -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">
                    <h4>پنل کاربری</h4>

                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item">
                            <a asp-area="UserPanel"
                               asp-controller="Home"
                               asp-action="Index">
                                صفحه نخست
                            </a>
                        </li>

                        <li class="breadcrumb-item active">
                            @ViewData["Title"]
                        </li>
                    </ol>
                </div>
            </div>
        </div>


        <div class="row">

            <!-- Main Content -->
            <div class="col-12 col-lg-9">

                <div class="card shadow-sm">
                    <div class="card-body">

                        <!-- Header -->
                        <div class="d-flex align-items-center mb-3">

                            <div class="cp-icon-tile cp-icon-tile--sm">
                                <i class="mdi mdi-telegram"></i>
                            </div>

                            <div class="cp-header-text">
                                <h5 class="cp-title">
                                    اتصال به بله
                                </h5>

                                <small class="cp-sub">
                                    حساب بله خود را متصل کنید تا هشدارهای قیمتی را دریافت کنید.
                                </small>
                            </div>

                        </div>

                        <hr class="card-divider mb-4" />


                        <!-- Telegram Connection -->
                        <div class="text-center py-4">

                            <div class="cp-hero-avatar">
                                <i class="mdi mdi-telegram"></i>
                            </div>

                            <h6 class="cp-hero-title">
                                اتصال حساب بله
                            </h6>

                            <p class="cp-hero-desc">
                                برای ادامه، ابتدا حساب بله خود را از طریق ربات ما متصل کنید.
                            </p>


                            <!-- Connect -->
                            <form asp-area="UserPanel"
                                  asp-controller="User"
                                  asp-action="ConnectBale"
                                  method="post"
                                  target="_blank"
                                  class="d-inline-block">

                                <button type="submit"
                                        class="btn btn-dark px-4">

                                    <i class="mdi mdi-telegram me-1"></i>
                                    اتصال به بله

                                </button>

                            </form>

                        </div>


                        <hr class="card-divider my-4" />


                        <!-- Test Message -->
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">

                            <div>
                                <h6 class="cp-item-title">
                                    تست اتصال
                                </h6>

                                <small class="cp-item-sub">
                                    پس از اتصال، یک پیام آزمایشی برای شما ارسال کنید.
                                </small>
                            </div>

                            <form asp-area="UserPanel"
                                  asp-controller="User"
                                  asp-action="SendBaleTestMessage"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-outline-success btn-sm px-3">

                                    <i class="mdi mdi-bell-check-outline me-1"></i>
                                    پیام آزمایشی

                                </button>

                            </form>

                        </div>


                        <!-- Proceed -->
                        <div class="cp-proceed">

                            <form asp-area="UserPanel"
                                  asp-controller="User"
                                  asp-action="CheckProfile"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-dark px-4">

                                    <i class="mdi mdi-check me-1"></i>
                                    ادامه

                                </button>

                            </form>

                        </div>

                    </div>
                </div>

            </div>


            <!-- ===================================== -->
            <!-- Sidebar                               -->
            <!-- ===================================== -->

            <div class="col-12 col-lg-3">

                <div class="card bg-light shadow-sm">

                    <div class="card-body">

                        <div class="d-flex align-items-center mb-3">
                            <i class="mdi mdi-information-outline cp-info-icon"></i>
                            <h6 class="cp-sidebar-title">
                                تکمیل حساب
                            </h6>
                        </div>

                        <p class="cp-sidebar-text">
                            برای استفاده از خدمات دیجیتو
                            اطلاعات شخصی خود را تکمیل کرده و حساب بله
                            خود را متصل کنید.
                        </p>

                        <div class="cp-benefits">

                            <div class="cp-benefit">
                                <i class="mdi mdi-check-circle-outline cp-benefit-icon cp-benefit-icon--success"></i>
                                <small class="cp-benefit-text">
                                    دریافت هشدارهای تغییر قیمت
                                </small>
                            </div>

                            <div class="cp-benefit">
                                <i class="mdi mdi-telegram cp-benefit-icon"></i>
                                <small class="cp-benefit-text">
                                    ارسال مستقیم اعلان‌ها در بله
                                </small>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>