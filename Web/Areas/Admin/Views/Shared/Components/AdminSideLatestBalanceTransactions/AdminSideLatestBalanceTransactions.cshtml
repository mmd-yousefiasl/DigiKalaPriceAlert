@using Application.Dtos.BalanceTransaction.AdminSide
@using Application.Tools
@model AdminSideFilterBalanceTransactionsDto

<div class="card">
    <div class="card-body">
        <h4 class="card-title mb-3 text-dark font-size-14">
            آخرین
            <a permission="ManageBalanceTransaction" asp-area="Admin" asp-controller="BalanceTransaction" asp-action="BalanceTransactionsList" asp-route-userId="@Model.UserId">
                تراکنش‌های مالی
            </a>
        </h4>
        <div class="table-responsive">
            <table class="table table-sm table-hover table-centered mb-0 font-size-13">
                <thead class="table-light">
                    <tr>
                        <th style="width: 40px;"></th>
                        <th>تاریخ</th>
                        <th>مقدار</th>
                        <th>نوع</th>
                        <th>وضعیت</th>
                        <th>کد تراکنش</th>
                    </tr>
                </thead>
                @if (Model?.Entities?.Any() ?? false)
                {
                    <tbody>
                        @{
                            int counter = 0;
                            foreach (var item in Model.Entities ?? new List<AdminSideBalanceTransactionDto>())
                            {
                                counter++;
                                <tr onclick="toggleRow('desc-div-@counter')" class="cursor-pointer">
                                    <td class="text-center">
                                        <i class="mdi mdi-chevron-down font-size-16 text-muted toggle-icon"></i>
                                    </td>
                                    <td class="text-muted">@item.CreatedDate.GetDateTime()</td>
                                    <td class="fw-bold text-dark">@item.Amount.ToToman()</td>
                                    <td>
                                        <span class="badge bg-soft-dark text-dark" style="background-color: #f1f1f1;">
                                            @item.Type.GetDisplayName()
                                        </span>
                                    </td>
                                    <td class="text-muted">
                                        @if (item.IsSuccess)
                                        {
                                            <span class="text-success">موفق</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">ناموفق</span>
                                        }
                                    </td>
                                    <td class="fw-bold">@item.TransId</td>
                                </tr>
                                <tr>
                                    <td colspan="6" class="p-0 border-0">
                                        <div id="desc-div-@counter" class="transaction-description">
                                            <div class="p-3 border-top border-bottom">
                                                <strong class="d-block mb-1 font-size-12 text-muted"><i class="mdi mdi-text-align-right me-1"></i> توضیحات کامل تراکنش:</strong>
                                                <p class="mb-0 text-wrap lh-base text-dark">
                                                    @item.Description
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                }
                else
                {
                    <tbody>
                        <tr>
                            <td colspan="100">
                                <partial name="_NotFoundPartial" />
                            </td>
                        </tr>
                    </tbody>
                }
            </table>
        </div>
    </div>
</div>