@using Application.Dtos.PaymentData
@model AdminSideUpdatePaymentDataDto

@{
    ViewData["Title"] = "ویرایش اطلاعات پرداخت";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت اطلاعات پرداخت</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12 col-md-9">
            <div class="card">
                <form class="card-body" asp-area="Admin" asp-controller="PaymentData" asp-action="UpdatePaymentData" autocomplete="off" enctype="multipart/form-data" onsubmit="submitAnimation()" method="post">
                    <input class="d-none image-input" type="file" asp-for="File" accept="image/*" />
                    <input type="hidden" asp-for="FileName" />

                    <h4 class="card-title">@ViewData["Title"]</h4>

                    <div class="mb-3 row">
                        <label asp-for="PaymentGatewayPin" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="PaymentGatewayPin">
                            <span asp-validation-for="PaymentGatewayPin" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label asp-for="Url" class="col-md-2 col-form-label"></label>
                        <div class="col-md-10">
                            <input class="form-control" asp-for="Url">
                            <span asp-validation-for="Url" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-12 text-end mt-5">
                        <button class="btn btn-primary btn-submit" type="submit">ویرایش</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-sm-12 col-md-3">
            <div class="card p-3">
                @if (Model.FileName is null)
                {
                    <img src="@SiteTools.DefaultImage" class="w-100 my-1 image-preview" alt="تصویر" />
                }
                else
                {
                    <img src="@SiteTools.PaymentLogo@Model.FileName" class="w-100 my-1 image-preview" alt="تصویر" />
                }
                <label asp-for="File" class="btn btn-primary m-0">انتخاب تصویر</label>
            </div>
        </div>
    </div>
</div>