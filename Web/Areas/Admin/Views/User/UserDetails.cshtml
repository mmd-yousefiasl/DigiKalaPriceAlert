@using Application.Dtos.Role.AdminSide
@using Application.Dtos.Users.AdminSide
@using Application.Tools
@using Domain.Shared
@model AdminSideUserDetailsDto

@{
    ViewData["Title"] = "جزئیات کاربر";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت کاربران</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="User" asp-action="UsersList">لیست کاربران</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-4 col-lg-5">

            <div class="card text-center" style="border-top: 4px solid #000000;">
                <div class="card-body">
                    <div class="mb-3">
                        <div class="avatar-sm mx-auto bg-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                            <span class="text-white font-size-24 fw-bold">@Model.FirstName?.FirstOrDefault()</span>
                        </div>
                    </div>
                    @if (string.IsNullOrEmpty(Model.FirstName) && string.IsNullOrEmpty(Model.LastName))
                    {
                        <h5 class="font-size-16 mb-1 text-dark fw-bold">@Messages.EmptyFieldMessage</h5>
                    }
                    else
                    {
                        <h5 class="font-size-16 mb-1 text-dark fw-bold">
                            @(Model.FirstName ?? "") @(Model.LastName ?? "")
                        </h5>
                    }

                    <p class="text-muted font-size-13 mb-3">
                        @if (!string.IsNullOrEmpty(Model.Username))
                        {
                            @:@@@Model.Username
                        }
                        else
                        {
                            @Messages.EmptyFieldMessage
                        }
                    </p>

                    <div>
                        <span class="badge bg-dark px-3 py-2 font-size-12">
                            حساب کاربری
                            @if (!Model.IsUserBanned)
                            {
                                @: فعال
                            }
                            else
                            {
                                @: غیرفعال
                            }
                        </span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-4 pb-2 border-bottom text-dark font-size-14">اطلاعات ارتباطی و سیستم</h4>

                    <div class="table-responsive">
                        <table class="table table-borderless mb-0 font-size-13">
                            <tbody>
                                <tr>
                                    <th scope="row" class="text-muted ps-0" style="width: 40%;">شماره موبایل:</th>
                                    <td class="text-end fw-bold text-dark" dir="ltr">@Model.Mobile</td>
                                </tr>
                                <tr>
                                    <th scope="row" class="text-muted ps-0">آیدی چت تلگرام:</th>
                                    <td class="text-end fw-bold text-dark">
                                        @if (Model.ChatId is null)
                                        {
                                            @Messages.EmptyFieldMessage
                                        }
                                        else
                                        {
                                            @Model.ChatId
                                        }
                                    </td>
                                </tr>
                                @if (Model.UserRoles?.Any() ?? false)
                                {
                                    <tr>
                                        <th scope="row" class="text-muted ps-0">نقش‌های کاربری:</th>
                                        <td class="text-end">
                                            @foreach (var item in Model.UserRoles ?? new List<AdminSideRoleDto>())
                                            {
                                                <span class="badge border border-dark text-dark bg-transparent me-1">@item.Title</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-8 col-lg-7">

            <div class="card border border-dark">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-sm-7 mb-3 mb-sm-0">
                            <div class="d-flex align-items-center">
                                <div class="avatar-xs me-3 bg-soft-dark text-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background-color: #f1f1f1;">
                                    <i class="mdi mdi-wallet font-size-20"></i>
                                </div>
                                <div>
                                    <span class="text-muted font-size-13 d-block mb-1">موجودی فعلی کیف پول:</span>
                                    <h4 class="font-size-20 fw-bold text-dark mb-0">@Model.Balance.ToTomanFormat() <span class="font-size-13 fw-normal text-muted">تومان</span></h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-5 text-sm-end">
                            <a permission="ManageBalanceTransaction" asp-area="Admin" asp-controller="BalanceTransaction" asp-action="CreateNewBalanceTransaction" asp-route-userId="@Model.Id" class="btn btn-dark waves-effect waves-light">
                                <i class="mdi mdi-plus-circle me-1"></i> ثبت تراکنش جدید
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4 class="card-title mb-3 pb-2 border-bottom text-dark font-size-14">وضعیت اشتراک فعلی</h4>
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-3 mb-md-0">
                            <span class="text-muted font-size-13 d-block mb-1">عنوان پلن:</span>
                            <h5 class="font-size-15 fw-bold text-dark mb-0">@Model.SubscriptionPlanName</h5>
                        </div>
                        <div class="col-md-4 mb-3 mb-md-0">
                            <span class="text-muted font-size-13 d-block mb-1">تاریخ پایان اشتراک:</span>
                            <h5 class="font-size-15 fw-bold text-dark mb-0">
                                @if (Model.SubscriptionEndDate is null)
                                {
                                    @: همیشه رایگان
                                }
                                else
                                {
                                    @Model.SubscriptionEndDate?.GetDateTime()
                                }
                            </h5>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <span class="text-muted font-size-13 d-block mb-1">شناسه پلن:</span>
                            <span class="badge bg-dark font-size-11">ID: @Model.SubscriptionPlanId</span>
                        </div>
                    </div>
                </div>
            </div>

            @await Component.InvokeAsync("AdminSideLatestBalanceTransactions", Model.Id)
        </div>
    </div>
</div>