@using Application.Dtos.Users.AdminSide
@using Application.Tools
@model AdminSideUserDetailsDto

@{
    ViewData["Title"] = "جزئیات کاربر";
}

<div class="container-fluid">

    <div class="row">
        <div class="col-sm-6">
            <div class="page-title-box">
                <h4>مدیریت کاربران</h4>
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">صفحه نخست</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-area="Admin" asp-controller="User" asp-action="UsersList">لیست کاربران</a>
                    </li>
                    <li class="breadcrumb-item active">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="card border border-dark" style="border-top: 4px solid #000000 !important;">
            <div class="card-body">
                <h4 class="card-title mb-4 pb-2 border-bottom text-dark font-size-14 d-flex justify-content-between align-items-center">
                    <span><i class="mdi mdi-star-outline me-1 text-muted"></i> وضعیت اشتراک فعلی</span>
                </h4>
                <div class="row align-items-center mb-3">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <span class="text-muted font-size-13 d-block mb-1">اشتراک:</span>
                        <h5 class="font-size-15 fw-bold text-dark mb-0">
                            <span>اعلان تغییر قیمت</span>
                        </h5>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <span class="text-muted font-size-13 d-block mb-1">وضعیت:</span>
                        <h5 class="font-size-15 fw-bold text-dark mb-0">
                            @if (Model.DaysToNotificationSubscriptionEnd <= 0)
                            {
                                <span class="text-muted font-size-14">غیر فعال</span>
                            }
                            else
                            {
                                @Model.DaysToNotificationSubscriptionEnd
                                @: روز
                            }
                        </h5>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <span class="text-muted font-size-13 d-block mb-1">اشتراک:</span>
                        <h5 class="font-size-15 fw-bold text-dark mb-0">
                            <span>قیمت گذاری خودکار</span>
                        </h5>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <span class="text-muted font-size-13 d-block mb-1">وضعیت:</span>
                        <h5 class="font-size-15 fw-bold text-dark mb-0">
                            @if (Model.DaysToAutoPriceSubscriptionEnd <= 0)
                            {
                                <span class="text-muted font-size-14">غیر فعال</span>
                            }
                            else
                            {
                                @Model.DaysToAutoPriceSubscriptionEnd
                                @: روز
                            }
                        </h5>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border border-dark">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-sm-7 mb-3 mb-sm-0">
                        <div class="d-flex align-items-center">
                            <div class="avatar-xs me-3 bg-dark text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="mdi mdi-wallet font-size-20"></i>
                            </div>
                            <div>
                                <span class="text-muted font-size-13 d-block mb-1">موجودی فعلی کیف پول:</span>
                                <h4 class="font-size-20 fw-bold text-dark mb-0">@Model.Balance.ToTomanFormat() <span class="font-size-13 fw-normal text-muted">تومان</span></h4>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-5 text-sm-end">
                        <a permission="ManageBalanceTransaction" asp-area="Admin" asp-controller="BalanceTransaction" asp-action="CreateNewBalanceTransaction" asp-route-userId="@Model.Id" class="btn btn-dark waves-effect waves-light">
                            <i class="mdi mdi-plus-circle me-1"></i> ثبت تراکنش جدید
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @await Component.InvokeAsync("AdminSideLatestBalanceTransactions", Model.Id)
    </div>
</div>